---
import BaseLayout from "../layouts/BaseLayout.astro";
import Faq from "../components/Faq.astro";
import PageHeader from "../components/PageHeader.astro";
import { groups } from "../data/faq";

const count = groups.reduce((sum, group) => sum + group.questions.length, 0);
---

<BaseLayout title="常见问题 — 四非保研鼠群" description="四非保研鼠群的入群条件、加入方式、交流规则与投稿说明">
  <div class="container">
    <PageHeader title="常见问题" lead="关于入群、交流和投稿的常见疑问" art="bubbles">
      <span slot="meta">共 {count} 个问题</span>
    </PageHeader>
    <Faq />
  </div>
</BaseLayout>
