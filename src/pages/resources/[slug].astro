---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ImageLightbox from "../../components/ImageLightbox.astro";
import ForumPrompt from "../../components/ForumPrompt.astro";
import { activitiesForTags, activitySpans, phaseSpans, phasesForTags } from "../../data/calendar";

export async function getStaticPaths() {
  const tools = await getCollection("tools", ({ data }) => !data.draft);
  return tools.map((tool) => ({
    params: { slug: tool.id },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const { Content } = await render(tool);
const spans = phaseSpans();
const phases = phasesForTags(tool.data.tags, spans);
const lanes = activitiesForTags(tool.data.tags, activitySpans());
const when = [
  ...lanes.map((lane) => `${lane.name}（${lane.range}，贯穿多个阶段）`),
  ...phases.map((phase) => `${phase.name}（${phase.range}）`),
];
const months = Array.from({ length: 12 }, (_, index) => ({ month: index + 1, s: index / 12 }));
---

<BaseLayout title={`${tool.data.name} — 保研资源`} description={tool.data.description}>
  <div class="container">
    <Breadcrumb crumbs={[
      { label: "首页", href: "/" },
      { label: "保研资源", href: "/resources" },
      { label: tool.data.name },
    ]} />

    <article class="tool-detail">
      <header class="tool-detail__header">
        <p class="tool-detail__cat">
          <span>{tool.data.category}</span>
          {lanes.map((lane) => <span data-tone="prep">{lane.name}（{lane.range}）</span>)}
          {phases.map((phase) => <span data-tone={phase.tone}>{phase.name}</span>)}
        </p>
        <h1 class="tool-detail__title display">{tool.data.name}</h1>
        <p class="tool-detail__desc">{tool.data.description}</p>
        {when.length > 0 && (
          <div class="year" aria-label={`用得上的时间：${when.join("、")}`} role="img">
            <span class="year__months" aria-hidden="true">
              {months.map(({ month, s }) => <span style={`--s: ${s.toFixed(4)}`}>{month}<i> 月</i></span>)}
            </span>
            <span class="year__track" aria-hidden="true">
              {spans.map((phase) => (
                <span data-tone={phases.includes(phase) ? phase.tone : undefined}
                  style={`--s: ${phase.s.toFixed(4)}; --w: ${phase.w.toFixed(4)}`}></span>
              ))}
              {lanes.map((lane) => (
                <span class="year__lane" style={`--s: ${lane.s.toFixed(4)}; --w: ${lane.w.toFixed(4)}`}>
                  {lane.peakSpans.map((peak) => (
                    <i style={`--ps: ${((peak.s - lane.s) / lane.w).toFixed(4)}; --pw: ${(peak.w / lane.w).toFixed(4)}`}></i>
                  ))}
                </span>
              ))}
            </span>
          </div>
        )}
        <div class="tool-detail__meta">
          <div class="tool-detail__tags">
            {tool.data.tags.map((t) => (
              <span class="chip">{t}</span>
            ))}
          </div>
          <a class="btn btn--primary" href={tool.data.link} target="_blank" rel="noopener noreferrer">
            打开资源
            <svg viewBox="0 0 24 24" width="16" height="16"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>
      <ForumPrompt />
    </article>

    <a class="back-link" href="/resources">← 返回资源列表</a>
  </div>
  <ImageLightbox />
</BaseLayout>

<style>
  .tool-detail {
    max-width: 740px;
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(32px, 5vw, 56px) 0;
  }
  [data-tone="prep"] { --tone: var(--tone-prep); --tone-ink: var(--tone-prep-ink); }
  [data-tone="camp"] { --tone: var(--tone-camp); --tone-ink: var(--tone-camp-ink); }
  [data-tone="pre"] { --tone: var(--tone-pre); --tone-ink: var(--tone-pre-ink); }
  [data-tone="tm"] { --tone: var(--tone-tm); --tone-ink: var(--tone-tm-ink); }
  .tool-detail__cat {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    color: var(--ink-3);
    font-size: 14px;
  }
  .tool-detail__cat [data-tone] {
    color: var(--tone-ink);
    font-weight: 600;
  }
  .tool-detail__title {
    font-size: clamp(2rem, 4.4vw, 3rem);
    line-height: 1.15;
    margin: 12px 0 14px;
  }
  /* 一年的时间条：资源用得上的阶段亮起阶段色 */
  .year {
    display: grid;
    gap: 8px;
    margin: 4px 0 28px;
  }
  .year__months,
  .year__track {
    position: relative;
    display: block;
  }
  .year__months {
    height: 16px;
  }
  .year__months span,
  .year__track span {
    position: absolute;
    left: calc(var(--s) * 100%);
  }
  .year__months i {
    font-style: normal;
  }
  .year__months span {
    padding-left: 5px;
    border-left: 1px solid var(--line);
    color: var(--ink-3);
    font-size: 12px;
    line-height: 16px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .year__track {
    height: 12px;
  }
  .year__track span {
    top: 4px;
    width: calc(var(--w) * 100% - 3px);
    height: 4px;
    border-radius: 2px;
    background: var(--line-soft);
  }
  .year__track span[data-tone] {
    top: 0;
    height: 12px;
    border-radius: 4px;
    background: var(--tone);
  }
  /* 持续进行的活动：细线贯穿，最集中的时段加粗 */
  .year__track .year__lane {
    top: 4px;
    height: 4px;
    background: var(--tone-prep);
  }
  .year__lane i {
    position: absolute;
    top: -4px;
    left: calc(var(--ps) * 100%);
    width: calc(var(--pw) * 100%);
    height: 12px;
    border-radius: 4px;
    background: var(--tone-prep);
  }
  @media (max-width: 600px) {
    .year__months span {
      padding-left: 3px;
    }
    .year__months i {
      display: none;
    }
  }
  .tool-detail__desc {
    font-size: 1.1rem;
    color: var(--ink-2);
    line-height: 1.5;
    margin-bottom: 20px;
  }
  .tool-detail__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 20px 0;
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
    margin-bottom: 36px;
  }
  .tool-detail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .prose {
    color: var(--ink);
    line-height: 1.7;
    font-size: 1.05rem;
  }
  .prose :global(h2) {
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    margin: 2em 0 0.6em;
  }
  .prose :global(h3) {
    font-size: 1.15rem;
    margin: 1.6em 0 0.5em;
  }
  .prose :global(p) {
    margin: 0 0 1em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
    margin-bottom: 1em;
  }
  .prose :global(li) {
    margin-bottom: 0.4em;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ul ul) {
    list-style: circle;
  }
  .prose :global(ul.contains-task-list) {
    list-style: none;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
  .prose :global(:not(pre) > code) {
    padding: 0.15em 0.35em;
    border-radius: 4px;
    background: var(--bg-grey);
  }
  .prose :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    margin-block: 1.2em;
    padding: 18px;
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    overflow-wrap: normal;
  }
  .prose :global(img) {
    height: auto;
    margin-block: 1.2em;
    border-radius: 8px;
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }
  .prose :global(a) {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (hover: hover) {
    .prose :global(a:hover) {
      opacity: 0.75;
    }
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--line-soft);
    padding-left: 1em;
    color: var(--ink-2);
    margin: 1.2em 0;
  }
  .prose :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.97rem;
    margin-bottom: 1.2em;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 9px 14px;
    border-bottom: 1px solid var(--line-soft);
  }
  .prose :global(th) {
    font-weight: 600;
    color: var(--ink-2);
    font-size: 0.88rem;
    border-bottom-color: var(--line);
  }
  .back-link {
    display: inline-block;
    padding-block: 11px;
    margin-top: -11px;
    color: var(--ink-3);
    font-size: 0.9rem;
    margin-bottom: 37px;
    transition: color 0.2s;
  }
  @media (hover: hover) {
    .back-link:hover {
      color: var(--ink);
    }
  }
</style>
