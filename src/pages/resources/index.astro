---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolCard from "../../components/ToolCard.astro";
import PageHeader from "../../components/PageHeader.astro";
import CollectionSection from "../../components/CollectionSection.astro";

const tools = await getCollection("tools");
const sorted = tools.filter((t) => !t.data.draft).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, "zh"),
);
const categories = [...new Set(sorted.map((t) => t.data.category))];
---

<BaseLayout
  title="保研资源 — 四非保研鼠群"
  description="汇集保研相关工具、网站和参考资料。"
>
  <div class="container">
    <PageHeader
      eyebrow="资料与工具"
      title="保研资源"
      lead="查找招生信息、准备报名材料、安排报名时间所需的网站、工具和资料。"
      action={{ label: "推荐资源", href: "https://github.com/mousebaoyan/mousebaoyan.github.io/issues/new?template=resource-submission.yml" }}
    />

    {
      categories.map((cat) => (
        <CollectionSection title={cat}>
          <div class="tools-grid">
            {sorted
              .filter((t) => t.data.category === cat)
              .map((t) => (
                <ToolCard
                  name={t.data.name}
                  description={t.data.description}
                  category={t.data.category}
                  link={t.data.link}
                  tags={t.data.tags}
                  slug={t.id}
                />
              ))}
          </div>
        </CollectionSection>
      ))
    }
  </div>
</BaseLayout>

<style>
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(14px, 1.6vw, 20px);
  }
  @media (max-width: 860px) {
    .tools-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 540px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
