---
import ExperienceListing from "../../components/ExperienceListing.astro";
import { EXPERIENCE_PAGE_SIZE, getPublishedExperiences } from "../../lib/experiences";

const experiences = await getPublishedExperiences();
---

<ExperienceListing
  experiences={experiences.slice(0, EXPERIENCE_PAGE_SIZE)}
  total={experiences.length}
  currentPage={1}
  totalPages={Math.max(1, Math.ceil(experiences.length / EXPERIENCE_PAGE_SIZE))}
/>
