---
import BaseLayout from "../layouts/BaseLayout.astro";
import LogoArt from "../components/LogoArt.astro";
import { qqGroups } from "../site.config";

const [first, second] = qqGroups;
const spaced = (number: string) => number.replace(/(\d{3})(?=\d)/g, "$1 ");
const steps = [
  { title: "搜索群号", text: `优先在 QQ 中搜索${first.label} ${first.number}，确认群名是“${first.name}”；${first.label}满了再加${second.label} ${second.number}` },
  { title: "填写申请", text: "申请信息里写明年级和本科院校" },
  { title: "等待审核", text: "管理员通过后就能参与交流" },
];
const rules = [
  "友好交流，尊重其他群友，有分歧时就事论事",
  "禁止广告与无关链接",
  "欢迎分享经验和资料，招生要求以官方通知为准",
];
---

<BaseLayout title="加入鼠群 — 四非保研鼠群" description="四非保研鼠群的入群条件、QQ 群号、入群步骤与交流规则">
  <div class="container">
    <section class="join-hero" aria-labelledby="join-title">
      <div class="join-hero__copy">
        <h1 class="join-hero__title display" id="join-title">加入鼠群</h1>
        <p class="join-hero__lead">面向四非院校计算机相关专业同学，不限年级，上岸了也欢迎</p>

        <div class="join-hero__qq">
          <div class="join-hero__groups">
            {qqGroups.map((group) => (
              <div class="join-hero__group">
                <span class="join-hero__label">QQ {group.label}</span>
                <strong class="join-hero__number" aria-label={group.number}>{spaced(group.number)}</strong>
                <div class="join-hero__actions">
                  <button class="btn btn--primary" type="button" data-copy-group={group.number}>
                    <svg class="copy-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                    <span data-copy-label>复制群号</span>
                  </button>
                  <a class="btn btn--secondary" href={group.joinUrl} target="_blank" rel="noopener noreferrer">
                    打开 QQ 加群<span class="visually-hidden">（新窗口打开）</span>
                  </a>
                </div>
              </div>
            ))}
          </div>
          <p class="join-hero__status" role="status" aria-live="polite">优先加{first.label}，{first.label}满了再加{second.label}；链接打不开时，在 QQ 中搜索群号即可</p>
        </div>
      </div>
      <div class="join-hero__art">
        <LogoArt priority />
      </div>
    </section>

    <section class="steps" aria-labelledby="steps-title">
      <h2 class="section-title" id="steps-title">三步入群</h2>
      <ol class="steps__list">
        {steps.map((step, index) => (
          <li>
            <span class="steps__num" aria-hidden="true">{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="notes" aria-label="入群须知">
      <div class="notes__item">
        <h2 class="section-title">交流规则</h2>
        <ul class="notes__rules">
          {rules.map((rule) => <li>{rule}</li>)}
        </ul>
      </div>
      <div class="notes__item">
        <h2 class="section-title">入群免费</h2>
        <p>入群和日常交流都免费，鼠群不提供付费辅导。群友以个人名义提供的付费服务与鼠群无关</p>
        <a class="link-arrow" href="/faq/">
          更多常见问题
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .join-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
    padding: clamp(36px, 5vw, 64px) 0 clamp(48px, 6vw, 80px);
  }
  .join-hero__title {
    font-size: clamp(2.25rem, 4.6vw, 3.25rem);
    line-height: 1.1;
  }
  .join-hero__lead {
    max-width: 30em;
    margin-top: 14px;
    color: var(--ink-2);
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.7;
    text-wrap: pretty;
  }
  .join-hero__qq {
    margin-top: clamp(32px, 4vw, 48px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .join-hero__groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    gap: 28px clamp(32px, 4vw, 56px);
  }
  .join-hero__group {
    display: grid;
    justify-items: start;
  }
  .join-hero__label {
    color: var(--ink-3);
    font-size: 14px;
  }
  .join-hero__number {
    margin-top: 2px;
    font-size: clamp(2.25rem, 4.4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .join-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }
  .join-hero__status {
    min-height: 1.6em;
    margin-top: 12px;
    color: var(--ink-3);
    font-size: 13px;
  }

  .section-title {
    font-size: 22px;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }

  /* 三步入群：编号圆点之间用一条线连起来 */
  .steps {
    padding: clamp(32px, 4vw, 48px) 0;
    border-top: 1px solid var(--line);
  }
  .steps__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px clamp(24px, 4vw, 56px);
    margin-top: 28px;
    padding: 0;
    list-style: none;
  }
  .steps__list li {
    position: relative;
  }
  .steps__list li:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 19px;
    left: 52px;
    right: calc(clamp(24px, 4vw, 56px) * -1 + 12px);
    border-top: 2px dotted var(--line-strong);
  }
  .steps__num {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--on-ink);
    font-size: 17px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .steps__list h3 {
    margin-top: 18px;
    font-size: 18px;
    line-height: 1.4;
  }
  .steps__list p {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.7;
  }

  .notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px clamp(24px, 4vw, 56px);
    padding: clamp(32px, 4vw, 48px) 0 clamp(56px, 7vw, 96px);
    border-top: 1px solid var(--line);
  }
  .notes__item p {
    margin-top: 14px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.8;
  }
  .notes__item .link-arrow {
    margin-top: 6px;
  }
  .notes__rules {
    display: grid;
    gap: 10px;
    margin-top: 14px;
  }
  .notes__rules li {
    position: relative;
    padding-left: 20px;
    color: var(--ink-1);
    font-size: 15px;
    line-height: 1.7;
  }
  .notes__rules li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 0.75em;
    width: 8px;
    height: 2px;
    border-radius: 1px;
    background: var(--ink-3);
  }

  @media (max-width: 860px) {
    .join-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.5fr);
      gap: 28px;
    }
    .steps__list {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .steps__list li {
      display: grid;
      grid-template-columns: 40px minmax(0, 1fr);
      column-gap: 16px;
      padding-bottom: 24px;
    }
    .steps__num {
      grid-row: 1 / 3;
    }
    .steps__list h3 {
      margin-top: 8px;
    }
    .steps__list li:not(:last-child)::after {
      top: 48px;
      bottom: 6px;
      left: 19px;
      right: auto;
      border-top: 0;
      border-left: 2px dotted var(--line-strong);
    }
    .notes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* 竖屏手机：插画在标题上方 */
  @media (max-width: 600px) {
    .join-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 28px;
    }
    .join-hero__art {
      order: -1;
      width: min(52%, 220px);
    }
  }
  @media (max-width: 1000px) {
    .join-hero__groups {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 400px) {
    .join-hero__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
    }
  }
</style>

<script>
  onEveryPage(() => {
    const copyStatus = document.querySelector<HTMLElement>(".join-hero__status");
    if (!copyStatus) return;
    const copyButtons = document.querySelectorAll<HTMLButtonElement>("[data-copy-group]");
    const hint = copyStatus.textContent;
    let timer: ReturnType<typeof setTimeout>;
    const reset = () => {
      copyButtons.forEach((button) => {
        delete button.dataset.copied;
        button.querySelector<HTMLElement>("[data-copy-label]")!.textContent = "复制群号";
      });
      copyStatus.textContent = hint;
    };
    copyButtons.forEach((copyButton) => {
      copyButton.addEventListener("click", async () => {
        clearTimeout(timer);
        reset();
        try {
          await navigator.clipboard.writeText(copyButton.dataset.copyGroup ?? "");
          copyButton.dataset.copied = "";
          copyButton.querySelector<HTMLElement>("[data-copy-label]")!.textContent = "已复制";
          copyStatus.textContent = "群号已复制，可以在 QQ 中粘贴搜索";
        } catch {
          copyStatus.textContent = "复制失败，请手动选中上方群号";
        }
        timer = setTimeout(reset, 2400);
      });
    });
  });
</script>
