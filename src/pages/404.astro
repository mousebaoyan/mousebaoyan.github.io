---
import BaseLayout from "../layouts/BaseLayout.astro";
import SceneArt from "../components/SceneArt.astro";
---

<BaseLayout title="404 — 页面不存在" description="页面不存在">
  <div class="container not-found">
    <div class="not-found__art">
      <SceneArt name="sunset" />
    </div>
    <h1 class="not-found__title display">这一页不存在</h1>
    <p class="not-found__msg">页面可能已经移动或删除，检查一下网址，或者回首页看看</p>
    <div class="not-found__actions">
      <a class="btn btn--primary" href="/">回到首页</a>
      <button class="btn btn--secondary" type="button" data-search-open>搜索站内内容</button>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 64vh;
    padding-block: 48px 72px;
    text-align: center;
  }
  .not-found__art {
    width: min(60vw, 240px);
  }
  .not-found__title {
    margin-top: 28px;
    font-size: clamp(2rem, 4.4vw, 2.75rem);
    line-height: 1.15;
  }
  .not-found__msg {
    max-width: 26em;
    margin-top: 14px;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.7;
    text-wrap: balance;
  }
  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }
</style>
