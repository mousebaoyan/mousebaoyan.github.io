---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — 页面不存在" description="页面不存在">
  <div class="container not-found">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">页面不存在</h1>
    <p class="not-found__msg">页面可能已移动或删除，请检查网址或返回首页。</p>
    <div class="not-found__actions">
      <a class="btn btn--primary" href="/">返回首页</a>
      <button class="btn btn--secondary" type="button" data-search-open hidden>搜索站内内容</button>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 60vh;
    gap: 16px;
  }
  .not-found__code {
    font-size: clamp(4rem, 12vw, 9rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--blue);
    opacity: 0.15;
    line-height: 1;
    margin: 0;
  }
  .not-found__title {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .not-found__msg {
    text-wrap: balance;
    color: var(--ink-2);
    font-size: 1.05rem;
    margin: 0;
  }
  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 8px;
  }
</style>
