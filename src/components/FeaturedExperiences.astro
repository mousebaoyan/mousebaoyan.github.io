---
import { getCollection } from "astro:content";
import ExperienceCard from "./ExperienceCard.astro";

const experiences = await getCollection("experiences");
const featured = experiences
  .filter((e) => !e.data.draft)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured)
    || b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

{featured.length > 0 && (
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="section-head__title">保研经验</h2>
          <p class="section-head__lead">群友的准备过程、院校选择与面试经历</p>
        </div>
        <a class="link-arrow" href="/experiences">
          全部 {experiences.filter((e) => !e.data.draft).length} 篇
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="experience-list">
        {featured.map((e) => (
          <ExperienceCard
            title={e.data.title}
            author={e.data.author}
            date={e.data.date}
            school={e.data.school}
            target={e.data.target}
            excerpt={e.data.excerpt}
            tags={e.data.tags}
            slug={e.id}
          />
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .experience-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(14px, 1.6vw, 20px);
  }
</style>
