---
import { getCollection } from "astro:content";
import { groups } from "../data/faq";
import { getTalks, isAvailable } from "../lib/talks";

const [resources, experiences, talks] = await Promise.all([
  getCollection("tools", ({ data }) => !data.draft),
  getCollection("experiences", ({ data }) => !data.draft),
  getTalks(),
]);
const questions = groups.reduce((sum, group) => sum + group.questions.length, 0);

// 内联 SVG 图标（Lucide 风格描边），不用 emoji
const entries = [
  {
    href: "/experiences",
    title: "保研经验",
    desc: "群友的背景、准备过程与录取经历",
    count: `${experiences.length} 篇经验贴`,
    icon: '<path d="M6 2.5h8l4 4v15H6z" /><path d="M14 2.5v4h4M9 13h6M9 17h6" />',
  },
  {
    href: "/talks",
    title: "直播回放",
    desc: "往期分享直播的录屏与课件",
    count: `${talks.filter(isAvailable).length} 场可观看`,
    icon: '<rect x="3" y="5" width="18" height="12" rx="2" /><path d="m10.5 8.5 4 2.5-4 2.5zM8 20.5h8" />',
  },
  {
    href: "/resources",
    title: "保研资源",
    desc: "报名信息、实用工具与参考资料",
    count: `${resources.length} 项资源`,
    icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3-3a6 6 0 0 1-7.36 7.68L7.6 20.7A2.12 2.12 0 0 1 4.5 17.6l6.37-6.14a6 6 0 0 1 3.83-5.2z" />',
  },
  {
    href: "/faq",
    title: "常见问题",
    desc: "入群、交流规则与投稿说明",
    count: `${questions} 个问题`,
    icon: '<circle cx="12" cy="12" r="9" /><path d="M9.6 9.3a2.5 2.5 0 0 1 4.8 1c0 1.7-2.4 2.2-2.4 3.7M12 17.2h.01" />',
  },
];
---

<section class="entries" aria-label="网站栏目">
  <div class="container">
    <ul class="entries__grid">
      {entries.map((entry) => (
        <li>
          <a class="entry lift" href={entry.href}>
            <span class="entry__icon" aria-hidden="true">
              <svg class="icon" viewBox="0 0 24 24" set:html={entry.icon} />
            </span>
            <span class="entry__title">{entry.title}</span>
            <span class="entry__desc">{entry.desc}</span>
            <span class="entry__count">
              {entry.count}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .entries {
    padding-bottom: clamp(48px, 6vw, 80px);
  }
  .entries__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.4vw, 18px);
  }
  .entry {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 22px 22px 20px;
    border: 1px solid var(--line-soft);
    border-radius: var(--r);
    background: var(--glass);
  }
  .entry:hover {
    border-color: var(--blue-line);
    background: var(--surface-hover);
  }
  .entry:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }
  .entry__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--gradient-accent-soft);
    color: var(--blue);
  }
  .entry__title {
    margin-top: 18px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .entry__desc {
    flex: 1;
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.65;
  }
  .entry__count {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-top: 16px;
    color: var(--blue-ink);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .entry:hover .entry__count svg {
    transform: translateX(2px);
  }
  .entry__count svg {
    transition: transform 0.2s ease;
  }
  /* 接在首屏入场之后依次出现 */
  :global(:root[data-entrance]) .entries__grid > li {
    animation: entry-rise 0.9s var(--ease-out) both;
  }
  .entries__grid > li:nth-child(1) { animation-delay: 0.4s; }
  .entries__grid > li:nth-child(2) { animation-delay: 0.46s; }
  .entries__grid > li:nth-child(3) { animation-delay: 0.52s; }
  .entries__grid > li:nth-child(4) { animation-delay: 0.58s; }
  @keyframes entry-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  .entry__icon {
    transition: transform 0.4s var(--ease-out);
  }
  .entry:hover .entry__icon {
    transform: translateY(-2px) rotate(-4deg);
  }
  @media (max-width: 960px) {
    .entries__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .entry {
      padding: 18px 16px 16px;
    }
    .entry__icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
    }
    .entry__title {
      margin-top: 14px;
      font-size: 16px;
    }
    .entry__desc {
      font-size: 13px;
    }
  }
</style>
