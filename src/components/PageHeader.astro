---
interface Props {
  title: string;
  lead?: string;
  action?: { label: string; href: string };
}
const { title, lead, action } = Astro.props;
---

<header class="page-header">
  <div class="page-header__copy">
    <h1 class="page-header__title">{title}</h1>
    {lead && <p class="page-header__lead">{lead}</p>}
  </div>
  {action && (
    <a class="btn btn--secondary page-header__action" href={action.href} target="_blank" rel="noopener noreferrer" aria-label={`${action.label}（新窗口打开）`}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
      {action.label}
    </a>
  )}
</header>

<style>
  .page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 40px;
    padding: clamp(40px, 6vw, 72px) 0 clamp(28px, 4vw, 40px);
  }
  .page-header__copy {
    max-width: 640px;
  }
  .page-header__title {
    font-size: clamp(2rem, 4.4vw, 2.9rem);
    letter-spacing: -0.03em;
    line-height: 1.12;
  }
  .page-header__lead {
    margin-top: 14px;
    color: var(--ink-2);
    font-size: clamp(1rem, 1.6vw, 1.1rem);
    line-height: 1.65;
  }
  @media (max-width: 640px) {
    .page-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
