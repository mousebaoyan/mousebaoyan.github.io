---
import { site } from "../site.config";

import { groups } from "../data/faq";
---

<div class="faq" id="faq">
  <aside class="faq__sidebar">
    <nav class="faq__nav" aria-label="常见问题分类">
      <p class="faq__nav-title">问题分类</p>
      {groups.map((group, index) => (
        <a href={`#${group.id}`}>
          <span class="faq__nav-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          {group.title}
        </a>
      ))}
    </nav>
    <div class="faq__contact">
      <span class="faq__contact-label">四非保研鼠群 · QQ 群</span>
      <strong>{site.qqGroup}</strong>
      <a href="/join">查看入群指南 <span aria-hidden="true">→</span></a>
    </div>
  </aside>

  <div class="faq__content">
    {groups.map((group, groupIndex) => (
      <section class="faq__group" id={group.id} aria-labelledby={`${group.id}-title`}>
        <header class="faq__group-header">
          <h2 id={`${group.id}-title`}>{group.title}</h2>
          <span>{String(groupIndex + 1).padStart(2, "0")}</span>
        </header>
        <div class="faq__list">
          {group.questions.map((item, index) => (
            <details class="faq__item" id={`${group.id}-${index + 1}`} open={groupIndex === 0 && index === 0}>
              <summary>
                <span>{item.question}</span>
                <svg class="faq__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                  <path d="M5 12h14" />
                  <path class="faq__icon-vertical" d="M12 5v14" />
                </svg>
              </summary>
              <div class="faq__answer">
                <p>{item.answer}</p>
                {item.link && <a href={item.link.href}>{item.link.label} <span aria-hidden="true">→</span></a>}
              </div>
            </details>
          ))}
        </div>
      </section>
    ))}
  </div>
</div>

<style>
  .faq {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    align-items: start;
    gap: clamp(32px, 5vw, 72px);
    margin-top: 12px;
    margin-bottom: clamp(48px, 6vw, 80px);
    padding-top: 32px;
    border-top: 1px solid var(--line-soft);
  }
  .faq__sidebar {
    position: sticky;
    top: calc(var(--nav-h) + 28px);
  }
  .faq__nav-title {
    margin-bottom: 12px;
    color: var(--ink-3);
    font-size: 12px;
  }
  .faq__nav a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 10px 12px;
    border-radius: 9px;
    color: #505967;
    font-size: 14px;
    transition: color 0.18s ease, background-color 0.18s ease;
  }
  .faq__nav a:hover {
    background: var(--blue-soft);
    color: #0063c7;
  }
  .faq__nav-index {
    color: var(--ink-3);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  .faq__contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: 28px;
    padding: 20px;
    border: 1px solid var(--line-soft);
    border-radius: 12px;
    background: var(--bg-alt);
  }
  .faq__contact-label {
    color: var(--ink-2);
    font-size: 12px;
  }
  .faq__contact strong {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .faq__contact a,
  .faq__answer a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    color: #0063c7;
    font-size: 14px;
  }
  .faq__contact a:hover,
  .faq__answer a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .faq__group {
    scroll-margin-top: 20px;
  }
  .faq__group + .faq__group {
    margin-top: 32px;
  }
  .faq__group-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .faq__group-header h2 {
    font-size: 18px;
    line-height: 1.5;
  }
  .faq__group-header > span {
    color: var(--ink-3);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  .faq__list {
    border: 1px solid var(--line-soft);
    border-radius: 14px;
    overflow: clip;
  }
  .faq__item + .faq__item {
    border-top: 1px solid var(--line-soft);
  }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
    color: var(--ink);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.6;
    transition: background-color 0.18s ease;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary:hover {
    background: var(--bg-alt);
  }
  .faq__item[open] {
    background: #fafbfd;
  }
  .faq__icon {
    flex: none;
    color: #6e7785;
  }
  .faq__item[open] .faq__icon {
    color: var(--blue);
  }
  .faq__item[open] .faq__icon-vertical {
    display: none;
  }
  .faq__answer {
    padding: 0 60px 22px 24px;
    color: #5f6773;
    font-size: 15px;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }
  .faq a:focus-visible,
  .faq summary:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: -3px;
    border-radius: 8px;
  }
  @media (max-width: 760px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 20px;
      margin-top: 4px;
    }
    .faq__sidebar {
      position: static;
    }
    .faq__nav {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .faq__nav-title,
    .faq__nav-index,
    .faq__contact {
      display: none;
    }
    .faq__nav a {
      padding: 10px 12px;
      background: var(--bg-grey);
      font-size: 13px;
    }
    .faq__item summary {
      padding: 17px 18px;
      gap: 16px;
      font-size: 15px;
    }
    .faq__answer {
      padding: 0 18px 20px;
      font-size: 14px;
    }
  }
</style>

<script>
  function openLinkedQuestion() {
    let id: string;
    try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
    const target = document.getElementById(id);
    if (target instanceof HTMLDetailsElement && target.classList.contains("faq__item")) {
      target.open = true;
      requestAnimationFrame(() => target.scrollIntoView({ block: "start" }));
    }
  }
  openLinkedQuestion();
  window.addEventListener("hashchange", openLinkedQuestion);
</script>
