---
import { phases, milestones, activitySpans } from "../../data/calendar";

// 构建时先按构建日期渲染一次，页面打开时由下方内联脚本按访问者的日期校正
const now = new Date();
const year = now.getFullYear();
const t0 = Date.UTC(year, 0, 1);
const span = Date.UTC(year + 1, 0, 1) - t0;
const at = (monthDay: string) => {
  const [month, day] = monthDay.split("-").map(Number);
  return (Date.UTC(year, month - 1, day) - t0) / span;
};
const today = (Date.UTC(year, now.getMonth(), now.getDate()) - t0) / span;
const segments = phases.map((phase, index) => {
  const start = at(phase.start);
  const end = index + 1 < phases.length ? at(phases[index + 1].start) : 1;
  return { ...phase, s: start.toFixed(4), w: (end - start).toFixed(4) };
});
const current = segments.findLastIndex((phase) => Number(phase.s) <= today);
const months = Array.from({ length: 12 }, (_, index) => ({
  month: index + 1,
  s: at(`${index + 1}-01`).toFixed(4),
}));
const yearMilestones = (milestones[year] ?? []).map((item) => ({
  ...item,
  s: at(item.date.slice(5)).toFixed(4),
  label: item.label,
  day: `${Number(item.date.slice(5, 7))} 月 ${Number(item.date.slice(8))} 日`,
}));
const milestonesIn = (index: number) => yearMilestones.filter((item) =>
  Number(item.s) >= Number(segments[index].s)
  && Number(item.s) < Number(segments[index].s) + Number(segments[index].w));
const clientPhases = phases.map(({ id, name, start, cohort }) => ({ id, name, start, cohort }));
const lanes = activitySpans(year);
---

<section class="cal-section" id="calendar" aria-labelledby="calendar-title">
<div class="cal container" data-cal data-year={year}>
  <div class="cal__head">
    <h2 class="cal__title display" id="calendar-title">保研日历</h2>
    <p class="cal__date"><span data-cal-year>{year}</span> 年，今天是 <time data-cal-today>{now.getMonth() + 1} 月 {now.getDate()} 日</time></p>
  </div>

  <div class="cal__track" style={`--today-at: ${today.toFixed(4)}`} data-late={today > 0.9 ? "" : undefined}>
    <ol class="cal__months" aria-hidden="true">
      {months.map(({ month, s }) => <li style={`--s: ${s}`}>{month}<span>月</span></li>)}
    </ol>
    <div class="cal__bars" aria-hidden="true">
      {segments.map((phase, index) => (
        <span class="cal__bar" data-tone={phase.tone} data-phase={phase.id}
          data-selected={index === current ? "" : undefined} style={`--s: ${phase.s}; --w: ${phase.w}`}></span>
      ))}
      <span class="cal__future"></span>
    </div>
    <!-- 贯穿多个阶段的套磁：细线是持续进行，粗段是最集中的时候 -->
    {lanes.map((lane) => (
      <div class="cal__lane" style={`--s: ${lane.s.toFixed(4)}; --w: ${lane.w.toFixed(4)}`}>
        <span class="cal__lane-name" aria-hidden="true">{lane.name}</span>
        <span class="cal__lane-line" aria-hidden="true"></span>
        {lane.peakSpans.map((peak) => (
          <span class="cal__lane-peak" aria-hidden="true"
            style={`--ps: ${((peak.s - lane.s) / lane.w).toFixed(4)}; --pw: ${(peak.w / lane.w).toFixed(4)}`}></span>
        ))}
        <p class="visually-hidden">{lane.name}：{lane.note}</p>
      </div>
    ))}
    <span class="cal__future cal__future--lane" aria-hidden="true"></span>
    <span class="cal__now" aria-hidden="true"><span>今天</span></span>

    <div class="cal__tabs" role="tablist" aria-label="保研阶段">
      {segments.map((phase, index) => (
        <button class="cal__tab" type="button" role="tab" id={`phase-tab-${phase.id}`}
          aria-controls={`phase-${phase.id}`} aria-selected={index === current ? "true" : "false"}
          tabindex={index === current ? 0 : -1} data-tone={phase.tone} style={`--s: ${phase.s}; --w: ${phase.w}`}>
          {phase.name}
        </button>
      ))}
    </div>
  </div>

  <div class="cal__panels" style={`--caret: ${(Number(segments[current].s) + Number(segments[current].w) / 2).toFixed(4)}`}>
    {segments.map((phase, index) => (
      <section class="cal__panel" role="tabpanel" id={`phase-${phase.id}`} aria-labelledby={`phase-tab-${phase.id}`}
        data-tone={phase.tone} hidden={index !== current}>
        <div class="cal__main">
          <p class="cal__kicker">{phase.name}<span class="cal__range">{phase.range}</span></p>
          <h3 class="cal__goal display">{phase.goal.split(/(?<=，)/).map((part) => <span>{part}</span>)}</h3>
          <p class="cal__status">
            <span class="cal__cohort" data-cohort>{String(year + 1 + phase.cohort).slice(2)} 届</span>
            <span data-status>{index === current ? "进行中" : ""}</span>
          </p>
          <ul class="cal__todo" aria-label="这个阶段要做的事">
            {phase.todo.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <!-- 参考信息：当年的关键日期和相关内容 -->
        <div class="cal__aside">
          {milestonesIn(index).length > 0 && (
            <div class="cal__block" data-year-only>
              <h4 class="cal__block-title">{year} 年关键日期</h4>
              <ol class="cal__milestones">
                {milestonesIn(index).map((item) => (
                  <li data-date={item.date}>
                    <time datetime={item.date}>{item.day}</time>
                    <span>{item.label}</span>
                    <em data-countdown></em>
                  </li>
                ))}
              </ol>
            </div>
          )}
          <div class="cal__block">
            <h4 class="cal__block-title">相关内容</h4>
            <ul class="cal__links">
              {phase.links.map((link) => (
                <li>
                  <a href={link.href} {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                    {link.label}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      {link.external
                        ? <path d="M7 17 17 7M8 7h9v9" />
                        : <path d="m9 6 6 6-6 6" />}
                    </svg>
                    {link.external && <span class="visually-hidden">（新窗口打开）</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    ))}
  </div>
</div>
</section>

<script is:inline define:vars={{ clientPhases }}>
  // 首次绘制前按访问者的日期确定「今天」和当前阶段，避免构建日期过期
  (() => {
    const root = document.querySelector("[data-cal]");
    if (!root) return;
    const now = new Date();
    const y = now.getFullYear();
    const DAY = 864e5;
    const at = (year, monthDay) => {
      const [m, d] = monthDay.split("-").map(Number);
      return Date.UTC(year, m - 1, d);
    };
    const today = Date.UTC(y, now.getMonth(), now.getDate());
    const t0 = Date.UTC(y, 0, 1);
    const track = root.querySelector(".cal__track");
    const position = (today - t0) / (Date.UTC(y + 1, 0, 1) - t0);
    track.style.setProperty("--today-at", position.toFixed(4));
    track.toggleAttribute("data-late", position > 0.9);
    root.querySelector("[data-cal-year]").textContent = y;
    root.querySelector("[data-cal-today]").textContent = `${now.getMonth() + 1} 月 ${now.getDate()} 日`;
    // 关键日期只对应某一年，跨年后隐藏
    if (Number(root.dataset.year) !== y) root.querySelectorAll("[data-year-only]").forEach((el) => el.hidden = true);

    let current = 0;
    clientPhases.forEach((phase, index) => { if (at(y, phase.start) <= today) current = index; });
    root.dataset.current = String(current);
    const tabs = root.querySelectorAll("[role=tab]");
    const panels = root.querySelectorAll("[role=tabpanel]");
    const bars = root.querySelectorAll(".cal__bar");
    clientPhases.forEach((phase, index) => {
      const selected = index === current;
      tabs[index].setAttribute("aria-selected", String(selected));
      tabs[index].tabIndex = selected ? 0 : -1;
      panels[index].hidden = !selected;
      bars[index].toggleAttribute("data-selected", selected);
      let start = at(y, phase.start);
      let occurrence = y;
      let text = "进行中";
      if (index === current) {
        // 当前阶段：显示这个阶段还剩几天
        const end = index + 1 < clientPhases.length ? at(y, clientPhases[index + 1].start) : Date.UTC(y + 1, 0, 1);
        const left = Math.round((end - today) / DAY);
        text = left <= 1 ? "进行中，今天是最后一天" : `进行中，还剩 ${left} 天`;
        // 首屏底部的提示：现在所处的阶段
        const cue = document.querySelector("[data-hero-now]");
        if (cue) cue.textContent = phase.id === "next" ? "下一届开始准备了，看看保研日历" : `现在是${phase.name}阶段，还剩 ${left} 天`;
        const bar = bars[index];
        root.querySelector(".cal__panels").style.setProperty("--caret",
          (Number(bar.style.getPropertyValue("--s")) + Number(bar.style.getPropertyValue("--w")) / 2).toFixed(4));
      } else {
        if (start <= today) start = at(occurrence = y + 1, phase.start);
        const days = Math.round((start - today) / DAY);
        text = days === 1 ? "明天开始" : `${days} 天后开始`;
      }
      panels[index].querySelector("[data-status]").textContent = text;
      panels[index].querySelector("[data-cohort]").textContent = `${String(occurrence + 1 + phase.cohort).slice(2)} 届`;
    });
    let next = true;
    root.querySelectorAll(".cal__milestones li").forEach((item) => {
      const date = Date.parse(item.dataset.date);
      const days = Math.round((date - today) / DAY);
      const countdown = item.querySelector("[data-countdown]");
      if (days < 0) {
        item.dataset.state = "done";
        countdown.textContent = "已过";
      } else if (next) {
        next = false;
        item.dataset.state = "next";
        countdown.textContent = days === 0 ? "就是今天" : `还有 ${days} 天`;
      }
    });
  })();
</script>

<script>
  // 阶段切换：点击或用方向键在阶段之间移动
  const root = document.querySelector<HTMLElement>("[data-cal]");
  if (root) {
    // 日历进入视野时再播放「今天」标记的入场动画
    const track = root.querySelector<HTMLElement>(".cal__track")!;
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        track.dataset.shown = "";
      }, { threshold: 0.6 });
      observer.observe(track);
    } else {
      track.dataset.shown = "";
    }
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[role=tabpanel]")];
    const bars = [...root.querySelectorAll<HTMLElement>(".cal__bar")];
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[i].hidden = !selected;
        bars[i].toggleAttribute("data-selected", selected);
      });
      // 托盘顶端的小尖角移到选中阶段的正下方
      const bar = bars[index];
      root.querySelector<HTMLElement>(".cal__panels")!.style.setProperty("--caret",
        (Number(bar.style.getPropertyValue("--s")) + Number(bar.style.getPropertyValue("--w")) / 2).toFixed(4));
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index));
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        const target = { ArrowRight: index === last ? 0 : index + 1, ArrowLeft: index === 0 ? last : index - 1, Home: 0, End: last }[event.key];
        if (target === undefined) return;
        event.preventDefault();
        select(target, true);
      });
    });
  }
</script>

<style>
  @property --today {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  [data-tone="prep"] { --tone: var(--tone-prep); --tone-ink: var(--tone-prep-ink); }
  [data-tone="camp"] { --tone: var(--tone-camp); --tone-ink: var(--tone-camp-ink); }
  [data-tone="pre"] { --tone: var(--tone-pre); --tone-ink: var(--tone-pre-ink); }
  [data-tone="tm"] { --tone: var(--tone-tm); --tone-ink: var(--tone-tm-ink); }

  .cal-section {
    padding-block: var(--section-space);
    border-top: 1px solid var(--line-soft);
  }
  .cal__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .cal__title {
    font-size: clamp(2rem, 3.4vw, 2.5rem);
    line-height: 1.1;
  }
  .cal__date {
    color: var(--ink-2);
    font-size: 16px;
    font-variant-numeric: tabular-nums;
  }
  /* 阶段详情放在浅灰托盘里，与时间轴分开；顶端小尖角指向选中的阶段 */
  .cal__panels {
    position: relative;
    margin-top: 18px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: 24px;
    background: var(--bg-grey);
  }
  .cal__panels::before {
    content: "";
    position: absolute;
    top: -8px;
    left: clamp(24px, calc(var(--caret) * 100%), calc(100% - 24px));
    width: 16px;
    height: 16px;
    margin-left: -8px;
    border-radius: 3px;
    background: var(--bg-grey);
    rotate: 45deg;
    transition: left 0.45s var(--ease-out);
  }

  /* —— 时间轴：月份刻度、阶段色条、今天的位置、阶段名 —— */
  .cal__track {
    position: relative;
    height: 142px;
    margin-top: 18px;
  }
  .cal__months {
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    padding: 0;
    list-style: none;
  }
  .cal__months li,
  .cal__bar,
  .cal__tab {
    position: absolute;
    left: calc(var(--s) * 100%);
  }
  .cal__months li {
    top: 26px;
    padding-left: 6px;
    padding-right: 4px;
    border-left: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink-3);
    font-size: 12px;
    line-height: 16px;
    font-variant-numeric: tabular-nums;
  }
  .cal__bars {
    position: absolute;
    inset: 54px 0 auto;
    height: 12px;
  }
  .cal__bar {
    top: 0;
    width: calc(var(--w) * 100% - 3px);
    height: 100%;
    border-radius: 3px;
    background: var(--tone);
    transform: scaleY(0.67);
    transition: transform 0.4s var(--ease-out);
  }
  .cal__bar[data-selected] {
    transform: none;
  }
  /* 今天之后的部分盖一层底色，色条变浅，看得出一年走到了哪里 */
  .cal__future {
    position: absolute;
    inset: -4px 0 -4px calc(var(--today) * 100%);
    background: color-mix(in srgb, var(--bg) 62%, transparent);
    pointer-events: none;
  }
  .cal__lane {
    position: absolute;
    top: 76px;
    left: calc(var(--s) * 100%);
    width: calc(var(--w) * 100%);
    height: 14px;
    pointer-events: none;
  }
  .cal__lane-name {
    position: absolute;
    right: calc(100% + 8px);
    top: 50%;
    translate: 0 -50%;
    color: var(--tone-prep-ink);
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }
  .cal__lane-line,
  .cal__lane-peak {
    position: absolute;
    border-radius: 4px;
    background: var(--tone-prep);
  }
  .cal__lane-line {
    inset: 6px 0;
    height: 2px;
  }
  .cal__lane-peak {
    top: 2px;
    left: calc(var(--ps) * 100%);
    width: calc(var(--pw) * 100%);
    height: 10px;
  }
  .cal__future--lane {
    inset: 72px 0 auto calc(var(--today) * 100%);
    height: 22px;
  }
  .cal__now {
    position: absolute;
    top: 0;
    left: calc(var(--today) * 100%);
    height: 96px;
    width: 2px;
    margin-left: -1px;
    border-radius: 1px;
    background: var(--ink);
    pointer-events: none;
  }
  .cal__now span {
    position: absolute;
    top: -2px;
    left: 8px;
    padding: 1px 7px;
    border-radius: 5px;
    background: var(--ink);
    color: var(--on-ink);
    font-size: 12px;
    font-weight: 600;
    line-height: 18px;
    white-space: nowrap;
  }
  /* 年底附近标签放到线的左侧，不会超出页面 */
  .cal__track[data-late] .cal__now span {
    left: auto;
    right: 8px;
  }
  .cal__tabs {
    position: absolute;
    inset: 46px 0 0;
  }
  .cal__tab {
    top: 0;
    bottom: 0;
    width: calc(var(--w) * 100%);
    padding: 52px 0 0 1px;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--ink-2);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  @media (hover: hover) {
    .cal__tab:hover {
      color: var(--ink);
    }
  }
  .cal__tab[aria-selected="true"] {
    color: var(--tone-ink);
    font-weight: 650;
  }
  .cal__tab:focus-visible {
    outline-offset: 2px;
  }

  /* 首次从站外打开时，日历滚进视野后「今天」的标记从一月一日走到今天 */
  .cal__track {
    --today: var(--today-at);
    transition: --today 1.6s var(--ease-out);
  }
  :global(:root[data-entrance]) .cal__track:not([data-shown]) {
    --today: 0;
  }

  /* —— 阶段详情：左边是这个阶段要做的事，右边是参考信息 —— */
  .cal__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: start;
    gap: 28px clamp(32px, 6vw, 88px);
    transition: opacity 0.3s ease, translate 0.4s var(--ease-out);
  }
  @starting-style {
    .cal__panel {
      opacity: 0;
      translate: 0 6px;
    }
  }
  .cal__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    color: var(--tone-ink);
    font-size: 14px;
    font-weight: 650;
  }
  .cal__kicker::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--tone);
  }
  .cal__range {
    color: var(--ink-2);
    font-weight: 400;
  }
  /* 目标按逗号分段换行，不会把最后一个字单独挤到下一行 */
  .cal__goal span {
    display: inline-block;
  }
  .cal__goal {
    margin-top: 10px;
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    line-height: 1.2;
  }
  .cal__status {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: 10px;
    color: var(--ink-2);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }
  .cal__cohort {
    color: var(--ink-1);
    font-weight: 600;
  }
  /* 待办：空心圆圈像一张清单 */
  .cal__todo {
    display: grid;
    gap: 14px;
    margin-top: 26px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .cal__todo li {
    position: relative;
    padding-left: 30px;
    color: var(--ink-1);
    font-size: 16px;
    line-height: 1.65;
  }
  .cal__todo li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.2em;
    width: 18px;
    height: 18px;
    border: 2px solid var(--tone);
    border-radius: 50%;
    box-sizing: border-box;
  }

  .cal__aside {
    display: grid;
    gap: 22px;
    padding: 22px 24px;
    border-radius: 18px;
    background: var(--surface);
  }
  .cal__block-title {
    margin-bottom: 12px;
    color: var(--ink-3);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
  }
  .cal__block + .cal__block {
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  /* 关键日期：竖线串起的小时间线 */
  .cal__milestones {
    position: relative;
    display: grid;
    gap: 12px;
    padding: 0;
    list-style: none;
  }
  .cal__milestones::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 8px;
    bottom: 8px;
    border-left: 2px solid var(--line);
  }
  .cal__milestones li {
    position: relative;
    display: grid;
    grid-template-columns: 5.4em minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 10px;
    padding-left: 22px;
    color: var(--ink-1);
    font-size: 14px;
    line-height: 1.5;
  }
  .cal__milestones li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.42em;
    width: 10px;
    height: 10px;
    border: 2px solid var(--ink-4);
    border-radius: 50%;
    box-sizing: border-box;
    background: var(--surface);
  }
  .cal__milestones time {
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .cal__milestones em {
    font-style: normal;
  }
  .cal__milestones [data-state="done"] {
    color: var(--ink-3);
  }
  .cal__milestones [data-state="done"]::before {
    border-color: var(--line-strong);
    background: var(--line-strong);
  }
  .cal__milestones [data-state="done"] em {
    display: none;
  }
  .cal__milestones [data-state="next"] span {
    color: var(--ink);
