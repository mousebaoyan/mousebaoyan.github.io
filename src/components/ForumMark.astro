---
// 鼠洞论坛的标志：从洞口探出头的鼠鼠，洞口也是朝阳，与论坛页面上的一致
interface Props { size?: number }
const { size = 20 } = Astro.props;
---

<svg class="forum-mark" viewBox="2 10 60 60" width={size} height={size} aria-hidden="true">
  <defs>
    <linearGradient id="forum-sun" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="forum-mark__sun-top" />
      <stop offset="1" class="forum-mark__sun-bottom" />
    </linearGradient>
  </defs>
  <path d="M10 42a22 22 0 0 1 44 0z" fill="url(#forum-sun)" />
  <g class="forum-mark__body" stroke-width="2.6" stroke-linejoin="round">
    <circle cx="24" cy="30.5" r="5.6" />
    <circle cx="40" cy="30.5" r="5.6" />
    <path d="M21 42a11 11 0 0 1 22 0z" />
  </g>
  <g class="forum-mark__blush">
    <circle cx="24" cy="30.5" r="2.2" />
    <circle cx="40" cy="30.5" r="2.2" />
    <ellipse cx="32" cy="40.3" rx="1.9" ry="1.4" />
  </g>
  <g class="forum-mark__ink">
    <circle cx="28.4" cy="36.6" r="1.5" />
    <circle cx="35.6" cy="36.6" r="1.5" />
  </g>
  <path class="forum-mark__shore" d="M4 42h56M12 48.5h40M19 54.5h26M26 60h12" stroke-width="2.6" stroke-linecap="round" />
</svg>

<style>
  .forum-mark { flex: none; }
  .forum-mark__sun-top { stop-color: #f9cda8; }
  .forum-mark__sun-bottom { stop-color: #ef9466; }
  .forum-mark__body { fill: #fffaf2; stroke: #2f403d; }
  .forum-mark__blush { fill: #f6b48c; }
  .forum-mark__ink { fill: #2f403d; }
  .forum-mark__shore { stroke: #2f403d; }
  :global(:root[data-theme="dark"]) .forum-mark__sun-top { stop-color: #e6a982; }
  :global(:root[data-theme="dark"]) .forum-mark__sun-bottom { stop-color: #c4764f; }
  :global(:root[data-theme="dark"]) .forum-mark__body { fill: #2b3331; stroke: #e9e2d3; }
  :global(:root[data-theme="dark"]) .forum-mark__blush { fill: #c98863; }
  :global(:root[data-theme="dark"]) .forum-mark__ink { fill: #e9e2d3; }
  :global(:root[data-theme="dark"]) .forum-mark__shore { stroke: #e9e2d3; }
</style>
