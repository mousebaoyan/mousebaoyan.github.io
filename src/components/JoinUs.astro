---
import { site } from "../site.config";

const rules = [
  "文明交流，禁止广告与无关链接",
  "鼓励分享保研经验与参考资料",
  "招生要求与时间安排以院校官方通知为准",
];
---

<section class="join" id="join">
  <div class="container join__inner">
    <div class="join__copy">
      <span class="join__eyebrow">加入鼠群</span>
      <h2 class="join__title">保研信息与经验交流</h2>
      <p class="join__lead">
        在 QQ 中搜索下方群号，申请加入「{site.name}」。
      </p>

      <div class="join__card">
        <span class="join__qqlabel">QQ 群号</span>
        <strong class="join__qqnum">{site.qqGroup}</strong>
        <button class="join__copybtn" data-copy={site.qqGroup}>复制群号</button>
      </div>

      <ul class="join__rules">
        {
          rules.map((r) => (
            <li>
              <svg class="join__check" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M5 13l4 4L19 7"
                  stroke="currentColor"
                  stroke-width="2"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span>{r}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .join {
    background: var(--bg-dark-gradient);
    color: var(--on-dark);
    padding-block: clamp(40px, 5vw, 64px);
    position: relative;
    overflow: hidden;
  }
  .join::before {
    content: "";
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
  }
  .join__inner {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
  }
  .join__eyebrow {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    background: linear-gradient(90deg, #5ea0ef, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
  }
  .join__title {
    color: #fff;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .join__lead {
    margin: 12px auto 0;
    max-width: 46ch;
    color: var(--on-dark-2);
    font-size: 1rem;
    line-height: 1.45;
  }
  .join__card {
    display: inline-grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 4px 24px;
    max-width: 100%;
    margin-top: 24px;
    padding: 16px 24px;
    text-align: left;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    border-radius: var(--r);
    box-shadow:
      0 0 60px rgba(0, 113, 227, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .join__qqlabel {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--on-dark-2);
  }
  .join__qqnum {
    grid-column: 1;
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 4vw, 2rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #fff;
    line-height: 1.1;
  }
  .join__copybtn {
    grid-column: 2;
    grid-row: 1 / 3;
    font: inherit;
    font-size: 0.9rem;
    min-height: 44px;
    padding: 9px 22px;
    border-radius: var(--r-pill);
    border: 0;
    background: var(--blue);
    color: #fff;
    cursor: pointer;
    transition:
      background 0.2s ease,
      box-shadow 0.3s ease;
  }
  .join__copybtn:hover {
    background: var(--blue-hover);
    box-shadow: 0 0 24px rgba(0, 113, 227, 0.3);
  }
  .join__rules {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: 24px auto 0;
  }
  .join__rules li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--on-dark-2);
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .join__check {
    flex: none;
    width: 18px;
    height: 18px;
    color: #5ea0ef;
  }
  @media (max-width: 540px) {
    .join__card {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      padding: 16px 24px;
      text-align: center;
    }
    .join__copybtn {
      grid-column: 1;
      grid-row: auto;
      margin-top: 8px;
    }
    .join__rules li {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLButtonElement>(".join__copybtn")
    .forEach((btn) => {
      btn.addEventListener("click", async () => {
        const text = btn.dataset.copy ?? "";
        try {
          await navigator.clipboard.writeText(text);
          const old = btn.textContent;
          btn.textContent = "已复制";
          setTimeout(() => (btn.textContent = old), 1600);
        } catch {
          btn.textContent = "复制失败";
        }
      });
    });
</script>
