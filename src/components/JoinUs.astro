---
import { site } from "../site.config";

const rules = [
  "入群和日常交流免费",
  "文明交流，禁止广告与无关链接",
  "招生要求与时间安排以院校官方通知为准",
];
---

<section class="join" id="join">
  <div class="container join__inner">
    <div class="join__copy">
      <h2 class="join__title">加入鼠群，一起准备保研</h2>
      <p class="join__lead">
        面向四非院校计算机相关专业同学，不限年级
      </p>
      <ul class="join__rules">
        {rules.map((rule) => (
          <li>
            <svg class="join__check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span>{rule}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="join__card">
      <span class="join__label">QQ 群号</span>
      <strong class="join__number">{site.qqGroup}</strong>
      <div class="join__actions">
        <button class="join__btn join__btn--copy" type="button" data-copy={site.qqGroup}><svg class="copy-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg><span data-copy-label>复制群号</span></button>
        <a class="join__btn" href={site.qqJoinUrl} target="_blank" rel="noopener noreferrer" aria-label="打开 QQ 加群（新窗口打开）">打开 QQ 加群 <span aria-hidden="true">↗</span></a>
      </div>
      <a class="join__guide" href="/join">查看入群指南</a>
    </div>
  </div>
</section>

<style>
  .join {
    position: relative;
    padding-block: clamp(56px, 7vw, 88px);
    background: var(--bg-dark-gradient);
    color: var(--on-dark);
    overflow: hidden;
  }
  /* 深色模式下与页面背景接近，用细线分隔 */
  :global(:root[data-theme="dark"]) .join {
    border-block: 1px solid var(--line-soft);
  }
  /* 横幅始终是深色，选中文字时用深蓝底白字 */
  .join ::selection {
    background: rgba(41, 151, 255, 0.45);
    color: #fff;
    -webkit-text-fill-color: #fff;
  }
  .join__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 400px);
    align-items: center;
    gap: clamp(32px, 6vw, 80px);
  }
  .join__title {
    color: #fff;
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .join__lead {
    max-width: 30em;
    margin-top: 14px;
    color: var(--on-dark-2);
    font-size: 16px;
    line-height: 1.7;
  }
  .join__rules {
    display: grid;
    gap: 10px;
    margin-top: 24px;
  }
  .join__rules li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #c7c7cc;
    font-size: 14px;
    line-height: 1.5;
  }
  .join__check {
    flex: none;
    width: 18px;
    height: 18px;
    color: #5ea0ef;
  }
  .join__card {
    display: flex;
    flex-direction: column;
    padding: 28px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--r-lg);
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 0 60px rgba(0, 113, 227, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .join__label {
    color: var(--on-dark-2);
    font-size: 13px;
  }
  .join__number {
    margin-top: 6px;
    color: #fff;
    font-family: var(--font-mono);
    font-size: clamp(2rem, 4vw, 2.4rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.2;
    user-select: all;
  }
  .join__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 22px;
  }
  .join__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 9px 14px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 12px;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.18s ease, border-color 0.18s ease;
  }
  .join__btn:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  /* 横幅始终是深色，按钮用固定的深蓝以保证白字对比度 */
  .join__btn--copy {
    border-color: #0071e3;
    background: #0071e3;
  }
  .join__btn--copy:hover {
    border-color: #0077ed;
    background: #0077ed;
  }
  .join__guide {
    align-self: flex-start;
    margin-top: 16px;
    color: #8cbcf3;
    font-size: 13px;
  }
  .join__guide:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .join :focus-visible {
    outline-color: #8cbcf3;
  }
  @media (max-width: 820px) {
    .join__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 400px) {
    .join__card {
      padding: 22px 18px;
    }
    .join__actions {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".join__btn--copy").forEach((btn) => {
    const label = btn.querySelector<HTMLElement>("[data-copy-label]")!;
    let timer: ReturnType<typeof setTimeout>;
    btn.addEventListener("click", async () => {
      clearTimeout(timer);
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        btn.dataset.copied = "";
        label.textContent = "已复制";
      } catch {
        label.textContent = "复制失败，请手动选中群号";
      }
      timer = setTimeout(() => {
        delete btn.dataset.copied;
        label.textContent = "复制群号";
      }, 1800);
    });
  });
</script>
