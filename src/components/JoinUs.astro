---
import { qqGroups } from "../site.config";

// 群号三位一组显示，复制时不带空格
const spaced = (number: string) => number.replace(/(\d{3})(?=\d)/g, "$1 ");
---

<section class="join" id="join" aria-labelledby="join-title">
  <div class="container join__inner">
    <div class="join__copy">
      <h2 class="join__title display" id="join-title">加入鼠群</h2>
      <p class="join__lead">面向四非院校计算机相关专业同学，不限年级，入群和交流都免费。优先加一群，一群满了再加二群</p>
      <a class="join__guide" href="/join">入群指南与群规</a>
    </div>

    <div class="join__groups">
      {qqGroups.map((group) => (
        <div class="join__qq">
          <span class="join__label">QQ {group.label}</span>
          <strong class="join__number display" aria-label={group.number}>{spaced(group.number)}</strong>
          <div class="join__actions">
            <button class="join__btn join__btn--copy" type="button" data-copy={group.number}><svg class="copy-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg><span data-copy-label>复制群号</span></button>
            <a class="join__btn" href={group.joinUrl} target="_blank" rel="noopener noreferrer">打开 QQ 加群<span class="visually-hidden">（新窗口打开）</span></a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .join {
    padding-block: clamp(56px, 7vw, 96px);
    background: var(--bg-dark-gradient);
    color: var(--on-dark);
  }
  :global(:root[data-theme="dark"]) .join {
    border-top: 1px solid var(--line-soft);
  }
  /* 横幅始终是深色，选中文字时用深蓝底白字 */
  .join ::selection {
    background: rgba(91, 140, 255, 0.5);
    color: #fff;
  }
  .join__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 40px clamp(32px, 6vw, 96px);
  }
  .join__title {
    color: #fff;
    font-size: clamp(2rem, 3.4vw, 2.5rem);
    line-height: 1.1;
  }
  .join__lead {
    max-width: 32em;
    margin-top: 14px;
    color: var(--on-dark-2);
    font-size: 16px;
    line-height: 1.75;
  }
  .join__guide {
    display: inline-block;
    margin-top: 8px;
    margin-bottom: -10px;
    padding-block: 10px;
    color: #fff;
    font-size: 15px;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.35);
    text-underline-offset: 5px;
    transition: text-decoration-color 0.2s ease;
  }
  @media (hover: hover) {
    .join__guide:hover {
      text-decoration-color: #fff;
    }
  }
  .join__groups {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 32px clamp(32px, 4vw, 56px);
  }
  .join__qq {
    display: grid;
    justify-items: start;
  }
  .join__label {
    color: var(--on-dark-2);
    font-size: 14px;
  }
  .join__number {
    margin-top: 4px;
    color: #fff;
    font-size: clamp(2.25rem, 3.6vw, 2.75rem);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .join__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .join__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 9px 18px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 12px;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.18s ease, border-color 0.18s ease, transform 0.2s var(--ease-quart);
  }
  @media (hover: hover) {
    .join__btn:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.4);
    }
  }
  .join__btn:active {
    transform: scale(0.97);
  }
  .join__btn--copy {
    border-color: #fff;
    background: #fff;
    color: #14161b;
  }
  @media (hover: hover) {
    .join__btn--copy:hover {
      border-color: #e4e6ea;
      background: #e4e6ea;
    }
  }
  .join :focus-visible {
    outline-color: #fff;
  }
  @media (max-width: 820px) {
    .join__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .join__groups {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 400px) {
    .join__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
    }
    .join__btn {
      padding-inline: 10px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".join__btn--copy").forEach((btn) => {
    const label = btn.querySelector<HTMLElement>("[data-copy-label]")!;
    let timer: ReturnType<typeof setTimeout>;
    btn.addEventListener("click", async () => {
      clearTimeout(timer);
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        btn.dataset.copied = "";
        label.textContent = "已复制";
      } catch {
        label.textContent = "复制失败，请手动选中群号";
      }
      timer = setTimeout(() => {
        delete btn.dataset.copied;
        label.textContent = "复制群号";
      }, 1800);
    });
  });
</script>
