---
import { formatDuration, isAvailable, slidesFor, talkDate, type Talk } from "../lib/talks";

interface Props {
  talk: Talk;
  headingLevel?: "h2" | "h3";
}
const { talk, headingLevel: Heading = "h2" } = Astro.props;
const { title, date, exactDate, speakers, summary, duration, decks } = talk.data;
const available = isAvailable(talk);
const pages = decks.reduce((sum, deck) => sum + slidesFor(talk, deck).pages, 0);
const Tag = available ? "a" : "div";
---

<Tag
  class:list={["talk-card", { "talk-card--pending": !available }]}
  href={available ? `/talks/${talk.id}/` : undefined}
>
  <div class="talk-card__cover" aria-hidden="true">
    <span class="talk-card__year">{date.getFullYear()}</span>
    <span class="talk-card__day">{date.getMonth() + 1} 月{exactDate && ` ${date.getDate()} 日`}</span>
    <span class="talk-card__badge">
      {available ? (
        <><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z" /></svg>直播回放</>
      ) : "待后续完善"}
    </span>
  </div>

  <div class="talk-card__body">
    <p class="talk-card__meta">
      <time datetime={date.toISOString().slice(0, 10)}>{talkDate(talk)}</time>
      {speakers.length > 0 && <span>分享人：{speakers.join("、")}</span>}
    </p>
    <Heading class="talk-card__title">{title}</Heading>
    <p class="talk-card__summary">{summary}</p>
    <div class="talk-card__facts">
      {available ? (
        <>
          {duration && <span class="chip">回放 {formatDuration(duration)}</span>}
          {decks.length > 0 && <span class="chip chip--blue">课件 {decks.length} 份 · {pages} 页</span>}
        </>
      ) : (
        <span class="chip">录屏暂不可访问</span>
      )}
    </div>
  </div>
</Tag>

<style>
  .talk-card {
    display: grid;
    grid-template-columns: minmax(180px, 260px) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 32px);
    align-items: center;
    padding: 16px;
    border: 1px solid var(--line-soft);
    border-radius: var(--r);
    background: var(--bg);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  a.talk-card:hover {
    border-color: var(--blue-line);
    background: #fafcff;
  }
  a.talk-card:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }
  .talk-card__cover {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    aspect-ratio: 16 / 10;
    padding: 18px 22px;
    border-radius: 12px;
    background:
      radial-gradient(ellipse 80% 70% at 100% 0%, rgba(110, 86, 207, 0.14), transparent 60%),
      radial-gradient(ellipse 70% 80% at 0% 100%, rgba(0, 113, 227, 0.12), transparent 60%),
      var(--bg-alt);
    overflow: hidden;
  }
  .talk-card__year {
    font-size: clamp(2.4rem, 4.6vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(135deg, var(--ink) 30%, var(--blue) 85%, var(--purple) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .talk-card__day {
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 15px;
    font-weight: 500;
  }
  .talk-card__badge {
    position: absolute;
    left: 14px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px 3px 8px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.85);
    color: var(--blue-ink);
    font-size: 12px;
    font-weight: 500;
  }
  .talk-card__body {
    min-width: 0;
    padding-right: 12px;
  }
  .talk-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    color: #757a83;
    font-size: 13px;
  }
  .talk-card__title {
    margin-top: 8px;
    font-size: clamp(19px, 2vw, 22px);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.015em;
  }
  .talk-card__summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 8px;
    color: #6b7079;
    font-size: 15px;
    line-height: 1.7;
  }
  .talk-card__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .talk-card--pending {
    background: var(--bg-alt);
  }
  .talk-card--pending .talk-card__cover {
    background: var(--bg-grey);
  }
  .talk-card--pending .talk-card__year {
    background: none;
    -webkit-text-fill-color: #a1a1a6;
    color: #a1a1a6;
  }
  .talk-card--pending .talk-card__day {
    color: var(--ink-3);
  }
  .talk-card--pending .talk-card__badge {
    color: var(--ink-2);
  }
  .talk-card--pending .talk-card__title {
    color: #4c5563;
  }

  @media (max-width: 640px) {
    .talk-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding: 12px 12px 18px;
    }
    .talk-card__cover {
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
      aspect-ratio: auto;
      padding: 16px;
    }
    .talk-card__year {
      font-size: 30px;
    }
    .talk-card__day {
      margin-top: 0;
    }
    .talk-card__badge {
      position: static;
      align-self: center;
      margin-left: auto;
    }
    .talk-card__body {
      padding-inline: 6px;
    }
  }
</style>
