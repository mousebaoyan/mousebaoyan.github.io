---
import { site } from "../site.config";
import LogoArt from "./LogoArt.astro";
import YearCalendar from "./home/YearCalendar.astro";
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title display">
        <span class="visually-hidden">{site.name}：</span>
        <span class="hero__from">四非鼠鼠</span>
        <span class="hero__to">一起上岸</span>
      </h1>
      <p class="hero__lead"><span>四非院校计算机同学的保研互助群，</span><span>一千多名群友在这里交流</span></p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/join">加入鼠群</a>
        <a class="btn btn--secondary" href="#routes">看看大家去了哪</a>
      </div>
    </div>

    <div class="hero__art">
      <LogoArt priority />
    </div>
  </div>
  <YearCalendar />
</section>

<style>
  .hero {
    padding-bottom: clamp(40px, 5vw, 72px);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
    padding-block: clamp(32px, 5vw, 64px) clamp(36px, 4.5vw, 60px);
  }
  /* 标题两行错开，第二行向右缩进 */
  .hero__title {
    display: grid;
    font-size: clamp(3rem, 6vw, 4.75rem);
    line-height: 1.08;
  }
  .hero__to {
    padding-left: 1.6em;
  }
  .hero__lead {
    margin-top: 28px;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1.75;
  }
  .hero__lead span {
    display: inline-block;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .hero__art {
    justify-self: end;
    width: min(100%, 440px);
  }

  /* 平板和横屏手机：插画缩小，仍放在右侧 */
  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.55fr);
      gap: 28px;
    }
  }
  /* 竖屏手机：插画在标题上方 */
  @media (max-width: 600px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }
    .hero__art {
      order: -1;
      justify-self: center;
      width: min(58%, 250px);
    }
  }
  @media (max-width: 720px) {
    .hero__title {
      font-size: clamp(2.5rem, 12vw, 3.5rem);
    }
    .hero__to {
      padding-left: 0.9em;
    }
    .hero__lead {
      margin-top: 20px;
      font-size: 16px;
    }
    .hero__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
