---
interface Props {
  name: string;
  description: string;
  category: string;
  tags: string[];
  slug: string;
}
const { name, description, category, tags, slug } = Astro.props;
---

<a class="tool-card" href={`/resources/${slug}`}>
  <span class="tool-card__cat">{category}</span>
  <h3 class="tool-card__name">{name}</h3>
  <p class="tool-card__desc">{description}</p>
  <div class="tool-card__footer">
    <div class="tool-card__tags">
      {tags.slice(0, 3).map((t) => <span class="chip">{t}</span>)}
    </div>
    <span class="tool-card__go" aria-hidden="true">
      详情
      <svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </div>
</a>

<style>
  .tool-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(20px, 2.4vw, 26px);
    border: 1px solid var(--line-soft);
    border-radius: var(--r);
    background: var(--bg);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .tool-card:hover {
    border-color: var(--blue-line);
    background: #fafcff;
  }
  .tool-card:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }
  .tool-card__cat {
    color: var(--blue-ink);
    font-size: 13px;
    font-weight: 600;
  }
  .tool-card__name {
    margin-top: 8px;
    font-size: 19px;
    line-height: 1.35;
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
  }
  .tool-card__desc {
    flex: 1;
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.65;
  }
  .tool-card__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
    margin-top: 18px;
  }
  .tool-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tool-card__go {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
    color: var(--blue-ink);
    font-size: 13px;
  }
  .tool-card__go svg {
    width: 14px;
    height: 14px;
  }
</style>
