---
import { site, navLinks } from "../site.config";
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="nav" id="top">
  <div class="nav__bar container">
    <a class="nav__brand" href="/" aria-label={site.name}>
      <img class="nav__logo" src="/logo.jpg" alt="" width="34" height="34" />
      <span class="nav__brand-text">{site.name}</span>
    </a>

    <nav class="nav__links" aria-label="主导航">
      {navLinks.map((l) => (
        <a href={l.href} class={isActive(l.href) ? "active" : ""} aria-current={isActive(l.href) ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="nav__actions">
      <a class="nav__join" href="/join">
        加入鼠群
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
      </a>
      <button
        class="nav__toggle"
        type="button"
        aria-label="展开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="nav__mobile" id="mobile-menu" aria-label="移动端导航" hidden>
    {navLinks.map((l) => (
      <a href={l.href} class={isActive(l.href) ? "active" : ""} aria-current={isActive(l.href) ? "page" : undefined}>{l.label}</a>
    ))}
    <a class="nav__mobile-join" href="/join">加入鼠群</a>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(160%) blur(20px);
    -webkit-backdrop-filter: saturate(160%) blur(20px);
    border-bottom: 1px solid var(--line-soft);
  }
  .nav__bar {
    height: var(--nav-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 11px;
    font-weight: 650;
    font-size: 17px;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .nav__logo {
    border: 1px solid rgba(29, 29, 31, 0.06);
    border-radius: 10px;
    object-fit: cover;
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav__links a {
    padding: 9px 15px;
    border-radius: 9px;
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.18s ease, background-color 0.18s ease;
  }
  .nav__links a:hover {
    color: var(--ink);
    background: var(--bg-grey);
  }
  .nav__links a.active {
    color: #0063c7;
    background: var(--blue-soft);
  }
  .nav__actions {
    display: flex;
    align-items: center;
    justify-self: end;
  }
  .nav__join {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 38px;
    padding: 8px 15px;
    border: 1px solid var(--ink);
    border-radius: 10px;
    background: var(--ink);
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color 0.18s ease, border-color 0.18s ease;
  }
  .nav__join:hover {
    background: #38383c;
    border-color: #38383c;
  }
  .nav a:focus-visible,
  .nav__toggle:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }
  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-soft);
    border-radius: 10px;
    background: var(--bg);
    cursor: pointer;
    padding: 0;
  }
  .nav__toggle:hover,
  .nav__toggle[aria-expanded="true"] {
    background: var(--bg-grey);
  }
  .nav__toggle span {
    display: block;
    width: 18px;
    height: 1.5px;
    margin-inline: auto;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.2s ease;
  }
  .nav__toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(3.25px) rotate(45deg);
  }
  .nav__toggle[aria-expanded="true"] span:nth-child(2) {
    transform: translateY(-3.25px) rotate(-45deg);
  }
  .nav__mobile {
    display: none;
    position: absolute;
    top: 100%;
    inset-inline: 0;
    max-height: calc(100dvh - var(--nav-h));
    overflow-y: auto;
    flex-direction: column;
    gap: 5px;
    padding: 12px var(--gutter) 20px;
    border-bottom: 1px solid var(--line-soft);
    background: var(--bg);
    box-shadow: 0 12px 20px rgba(29, 29, 31, 0.04);
  }
  .nav__mobile a {
    padding: 12px 14px;
    border-radius: 10px;
    color: var(--ink-2);
    font-size: 15px;
    font-weight: 500;
  }
  .nav__mobile a:hover {
    background: var(--bg-grey);
    color: var(--ink);
  }
  .nav__mobile a.active {
    background: var(--blue-soft);
    color: #0063c7;
  }
  .nav__mobile .nav__mobile-join {
    margin-top: 8px;
    text-align: center;
    background: var(--ink);
    color: #fff;
  }
  @media (max-width: 800px) {
    .nav__bar {
      grid-template-columns: 1fr auto;
      gap: 12px;
    }
    .nav__brand {
      font-size: 16px;
      gap: 9px;
    }
    .nav__links,
    .nav__join {
      display: none;
    }
    .nav__toggle {
      display: flex;
    }
    .nav__mobile:not([hidden]) {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".nav__toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    const close = () => {
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "展开菜单");
      menu.hidden = true;
    };
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      menu.hidden = open;
      toggle.setAttribute("aria-label", open ? "展开菜单" : "收起菜单");
    });
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", close));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        close();
        toggle.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !menu.hidden && !menu.contains(event.target) && !toggle.contains(event.target)) close();
    });
    window.matchMedia("(min-width: 801px)").addEventListener("change", (event) => {
      if (event.matches) close();
    });
  }
</script>
