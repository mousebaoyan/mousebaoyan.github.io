---
import { site, navLinks, notice, forum } from "../site.config";
import ForumMark from "./ForumMark.astro";
// 内嵌的小尺寸标志：换页时无需等待网络，导航栏不会闪烁
import logo from "../assets/logo-96.webp?inline";
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<!-- 导航目标在页面加载后就预取：手机上没有悬停，等到点按时再取已经来不及。
     导航栏跨页保留，换页时只更新当前栏目 -->
<header class="nav" id="top" transition:persist="site-nav">
  <div class="nav__bar container">
    <a class="nav__brand" href="/" aria-label={site.name} data-astro-prefetch="load">
      <img class="nav__logo" src={logo} alt="" width="34" height="34" decoding="sync" />
      <span class="nav__brand-text">{site.name}</span>
    </a>

    <nav class="nav__links" aria-label="主导航">
      <span class="nav__pill" aria-hidden="true"></span>
      {navLinks.map((l) => (
        <a href={l.href} class={isActive(l.href) ? "active" : ""} aria-current={isActive(l.href) ? "page" : undefined} data-astro-prefetch="load">{l.label}</a>
      ))}
    </nav>

    <div class="nav__actions">
      {notice && (
        <button class="nav__icon nav__notice" type="button" data-notice-open aria-label="查看网站公告" title="网站公告" aria-haspopup="dialog" aria-controls="site-notice">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9.5a6 6 0 0 1 12 0c0 4.6 1.8 6.3 2.3 6.8H3.7c.5-.5 2.3-2.2 2.3-6.8z" /><path d="M10 19.8a2.2 2.2 0 0 0 4 0" /></svg>
          <span class="nav__notice-dot" aria-hidden="true"></span>
        </button>
      )}
      <button class="nav__icon nav__theme" type="button" data-theme-toggle aria-label="切换深色模式" title="切换深色模式">
        <svg class="nav__theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.8v2M12 19.2v2M2.8 12h2M19.2 12h2M5.5 5.5l1.4 1.4M17.1 17.1l1.4 1.4M5.5 18.5l1.4-1.4M17.1 6.9l1.4-1.4" /></svg>
        <svg class="nav__theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19.5 14.6A7.8 7.8 0 0 1 9.4 4.5a7.8 7.8 0 1 0 10.1 10.1z" /></svg>
      </button>
      <a class="nav__forum" href={forum.url} aria-label={`前往${forum.name}论坛`} title={`${forum.name}论坛`}>
        <ForumMark />
        <span>{forum.name}</span>
      </a>
      <a class="nav__join" href="/join/" data-astro-prefetch="load">
        加入鼠群
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
      </a>
      <button
        class="nav__toggle"
        type="button"
        aria-label="展开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="nav__mobile" id="mobile-menu" aria-label="移动端导航" hidden>
    {navLinks.map((l) => (
      <a href={l.href} class={isActive(l.href) ? "active" : ""} aria-current={isActive(l.href) ? "page" : undefined}>{l.label}</a>
    ))}
    <a class="nav__mobile-join" href="/join/">加入鼠群</a>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: var(--nav-bg);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--line-soft);
    view-transition-name: site-nav;
  }
  /* 页面顶部时导航与背景融为一体，滚动后出现分隔线 */
  @supports (animation-timeline: scroll()) {
    .nav {
      animation: nav-settle linear both;
      animation-timeline: scroll(root);
      animation-range: 0 64px;
    }
    @keyframes nav-settle {
      from {
        border-bottom-color: transparent;
        background-color: transparent;
      }
    }
  }
  .nav__bar {
    height: var(--nav-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: 44px;
    gap: 11px;
    font-weight: 650;
    font-size: 17px;
    white-space: nowrap;
  }
  .nav__logo {
    border: 1px solid var(--line-soft);
    border-radius: 10px;
    object-fit: cover;
  }
  .nav__links {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav__links a {
    position: relative;
    padding: 9px 15px;
    border-radius: 9px;
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  @media (hover: hover) {
    .nav__links a:hover {
      color: var(--ink);
      background: var(--bg-grey);
    }
  }
  .nav__links a.active {
    color: var(--blue-ink);
    background: var(--blue-soft);
  }
  /* 脚本就绪后，由一块滑动的底色代替各链接自己的底色 */
  .nav__pill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    border-radius: 9px;
    background: var(--bg-grey);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.38s var(--ease-out), width 0.38s var(--ease-out),
      background-color 0.25s ease, opacity 0.2s ease;
  }
  .nav__links[data-pill] a {
    background: transparent;
  }
  @media (hover: hover) {
    .nav__links[data-pill] a:hover {
      background: transparent;
    }
  }
  .nav__links[data-pill] .nav__pill {
    opacity: 1;
  }
  .nav__links[data-pill="active"] .nav__pill {
    background: var(--blue-soft);
  }
  .nav__links[data-pill="none"] .nav__pill {
    opacity: 0;
  }
  @media (hover: hover) {
    .nav__links[data-pill="hover"] a.active:not(:hover) {
      color: var(--ink-2);
    }
  }
  .nav__actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 12px;
  }
  .nav__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--line-soft);
    border-radius: 10px;
    background: var(--bg-alt);
    color: var(--ink-2);
    cursor: pointer;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  @media (hover: hover) {
    .nav__icon:hover {
      color: var(--ink);
      border-color: var(--line);
    }
  }
  .nav__icon:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }
  /* 公告进行中的提示点，与公告里「申诉处理中」的琥珀色一致 */
  .nav__notice-dot {
    position: absolute;
    top: 7px;
    right: 7px;
    width: 8px;
    height: 8px;
    border: 2px solid var(--bg-alt);
    border-radius: 50%;
    background: var(--tone-pre);
    box-sizing: content-box;
  }
  /* 太阳与月亮交替：旋转并缩放进出 */
  .nav__theme svg {
    grid-area: 1 / 1;
    transition: transform 0.5s var(--ease-out), opacity 0.3s ease;
  }
  .nav__theme-moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.4);
  }
  :global(:root[data-theme="dark"]) .nav__theme-sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.4);
  }
  :global(:root[data-theme="dark"]) .nav__theme-moon {
    opacity: 1;
    transform: none;
  }
  /* 鼠洞论坛入口：用论坛自己的海青色，与站内蓝色的导航区分开 */
  .nav__forum {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 38px;
    padding: 0 12px 0 9px;
    border: 1px solid color-mix(in srgb, var(--forum) 30%, transparent);
    border-radius: 10px;
    background: var(--forum-soft);
    color: var(--forum-ink);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 0.18s ease, border-color 0.18s ease;
  }
  @media (hover: hover) {
    .nav__forum:hover {
      border-color: var(--forum);
      background: color-mix(in srgb, var(--forum) 20%, var(--bg));
    }
  }
  /* 导航链接放不下文字时，鼠洞入口只留标志；手机上菜单收起后空间够，再显示文字 */
  @media (max-width: 1100px) {
    .nav__forum { width: 38px; padding: 0; }
    .nav__forum span { display: none; }
    .nav__forum svg { width: 24px; height: 24px; }
  }
  @media (max-width: 900px) and (min-width: 481px) {
    .nav__forum { width: auto; padding: 0 12px 0 9px; }
    .nav__forum span { display: inline; }
    .nav__forum svg { width: 20px; height: 20px; }
  }
  .nav__join {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 38px;
    padding: 8px 15px;
    border: 1px solid var(--ink);
    border-radius: 10px;
    background: var(--ink);
    color: var(--on-ink);
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color 0.18s ease, border-color 0.18s ease;
  }
  @media (hover: hover) {
    .nav__join:hover {
      background: var(--ink-hover);
      border-color: var(--ink-hover);
    }
  }
  .nav a:focus-visible,
  .nav__toggle:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }
  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-soft);
    border-radius: 10px;
    background: var(--bg);
    cursor: pointer;
    padding: 0;
  }
  .nav__toggle[aria-expanded="true"] {
    background: var(--bg-grey);
  }
  @media (hover: hover) {
    .nav__toggle:hover {
      background: var(--bg-grey);
    }
  }
  .nav__toggle span {
    display: block;
    width: 18px;
    height: 1.5px;
    margin-inline: auto;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.2s ease;
  }
  .nav__toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(3.25px) rotate(45deg);
  }
  .nav__toggle[aria-expanded="true"] span:nth-child(2) {
    transform: translateY(-3.25px) rotate(-45deg);
  }
  .nav__mobile {
    display: none;
    transition: opacity 0.25s ease, transform 0.35s var(--ease-out), display 0.35s allow-discrete;
    position: absolute;
    top: 100%;
    inset-inline: 0;
    max-height: calc(100dvh - var(--nav-h));
    overflow-y: auto;
    flex-direction: column;
    gap: 5px;
    padding: 12px var(--gutter) 20px;
    border-bottom: 1px solid var(--line-soft);
    background: var(--bg);
    box-shadow: 0 12px 20px rgba(29, 29, 31, 0.04);
  }
  .nav__mobile a {
    padding: 12px 14px;
    border-radius: 10px;
    color: var(--ink-2);
    font-size: 15px;
    font-weight: 500;
  }
  @media (hover: hover) {
    .nav__mobile a:hover {
      background: var(--bg-grey);
      color: var(--ink);
    }
  }
  .nav__mobile a.active {
    background: var(--blue-soft);
    color: var(--blue-ink);
  }
  .nav__mobile .nav__mobile-join {
    margin-top: 8px;
    text-align: center;
    background: var(--ink);
    color: var(--on-ink);
  }
  @media (max-width: 900px) {
    .nav__bar {
      grid-template-columns: 1fr auto;
      gap: 12px;
    }
    .nav__brand {
      font-size: 16px;
      gap: 9px;
    }
    .nav__links,
    .nav__join {
      display: none;
    }
    .nav__toggle {
      display: flex;
    }
    .nav__forum { min-width: 44px; height: 44px; }
    .nav__icon { width: 44px; height: 44px; background: transparent; }
    .nav__notice-dot { top: 9px; right: 9px; border-color: var(--bg); }
    .nav__actions { gap: 8px; }
    .nav__mobile:not([hidden]) {
      display: flex;
    }
    @starting-style {
      .nav__mobile:not([hidden]) {
        opacity: 0;
        transform: translateY(-8px);
      }
    }
    .nav__mobile:not([hidden]) a {
      animation: nav-item-in 0.4s var(--ease-out) both;
    }
    .nav__mobile:not([hidden]) a:nth-child(2) { animation-delay: 30ms; }
    .nav__mobile:not([hidden]) a:nth-child(3) { animation-delay: 60ms; }
    .nav__mobile:not([hidden]) a:nth-child(4) { animation-delay: 90ms; }
    .nav__mobile:not([hidden]) a:nth-child(5) { animation-delay: 120ms; }
    .nav__mobile:not([hidden]) a:nth-child(6) { animation-delay: 150ms; }
    @keyframes nav-item-in {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }
    }
  }
  /* 小屏手机上四个按钮收紧一些，给站名留出位置 */
  @media (max-width: 400px) {
    .nav__bar { gap: 8px; }
    .nav__actions { gap: 4px; }
    .nav__icon,
    .nav__forum,
    .nav__toggle { width: 40px; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".nav__toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    const close = () => {
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "展开菜单");
      menu.hidden = true;
    };
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      menu.hidden = open;
      toggle.setAttribute("aria-label", open ? "展开菜单" : "收起菜单");
    });
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", close));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        close();
        toggle.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !menu.hidden && !menu.contains(event.target) && !toggle.contains(event.target)) close();
    });
    window.matchMedia("(min-width: 901px)").addEventListener("change", (event) => {
      if (event.matches) close();
    });
    document.addEventListener("astro:before-swap", close);
  }

  // 滑动底色：停在当前栏目上，悬停时滑到对应链接
  const links = document.querySelector<HTMLElement>(".nav__links");
  const pill = links?.querySelector<HTMLElement>(".nav__pill");
  if (links && pill) {
    let active = links.querySelector<HTMLAnchorElement>("a.active");
    const moveTo = (link: HTMLAnchorElement | null, state: string) => {
      if (!link) {
        links.dataset.pill = "none";
        return;
      }
      pill.style.width = `${link.offsetWidth}px`;
      pill.style.transform = `translateX(${link.offsetLeft}px)`;
      links.dataset.pill = state;
    };
    // 首次定位不做动画
    pill.style.transition = "none";
    moveTo(active, "active");
    requestAnimationFrame(() => requestAnimationFrame(() => pill.style.removeProperty("transition")));
    links.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      link.addEventListener("pointerenter", () => moveTo(link, link === active ? "active" : "hover"));
      link.addEventListener("focus", () => moveTo(link, link === active ? "active" : "hover"));
    });
    links.addEventListener("pointerleave", () => moveTo(active, "active"));
    links.addEventListener("focusout", (event) => {
      if (!links.contains(event.relatedTarget as Node)) moveTo(active, "active");
    });
    document.fonts?.ready.then(() => moveTo(active, "active"));
    // 换页时照新页面标出当前栏目，底色滑到新栏目上
    const sections = (root: ParentNode) => root.querySelectorAll<HTMLAnchorElement>(".nav__links a, .nav__mobile a");
    document.addEventListener("astro:before-swap", ({ newDocument }) => {
      const next = sections(newDocument);
      sections(document).forEach((link, index) => {
        link.className = next[index].className;
        link.ariaCurrent = next[index].ariaCurrent;
      });
      active = links.querySelector<HTMLAnchorElement>("a.active");
      moveTo(active, "active");
    });
  }

  // 主题切换：与系统一致时不记录选择，系统切换时继续跟随
  const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  if (themeButton) {
    const root = document.documentElement;
    const system = matchMedia("(prefers-color-scheme: dark)");
    const motion = matchMedia("(prefers-reduced-motion: no-preference)");
    const label = () => {
      const text = root.dataset.theme === "dark" ? "切换到浅色模式" : "切换到深色模式";
      themeButton.setAttribute("aria-label", text);
      themeButton.title = text;
    };
    const apply = (theme: string) => {
      root.dataset.theme = theme;
      label();
      window.dispatchEvent(new CustomEvent("themechange", { detail: theme }));
    };
    label();
    themeButton.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      try {
        if ((next === "dark") === system.matches) localStorage.removeItem("theme");
        else localStorage.setItem("theme", next);
      } catch { /* 无法存储时只切换当前页面 */ }
      if (!document.startViewTransition || !motion.matches) {
        apply(next);
        return;
      }
      // 新主题从按钮处以圆形展开
      const rect = themeButton.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      root.dataset.themeSwitch = "";
      const transition = document.startViewTransition(() => apply(next));
      transition.ready.then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 560, easing: "cubic-bezier(0.16, 1, 0.3, 1)", pseudoElement: "::view-transition-new(root)" },
        );
      }).catch(() => {});
      transition.finished.finally(() => delete root.dataset.themeSwitch);
    });
    system.addEventListener("change", (event) => {
      let stored = null;
      try { stored = localStorage.getItem("theme"); } catch { /* 视为未选择 */ }
      if (!stored) apply(event.matches ? "dark" : "light");
    });
  }
</script>
