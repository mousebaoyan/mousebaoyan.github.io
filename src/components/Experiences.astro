---
const posts = [
  {
    school: "示例 · 某 985 计算机",
    title: "双非院校学生的夏令营与预推免申请记录",
    summary: "申请背景、时间安排、导师联系与面试经验。",
    tags: ["夏令营", "预推免"],
    url: "#",
  },
  {
    school: "示例 · 某 211 软件学院",
    title: "科研经历有限时的项目整理与展示",
    summary: "课程项目的工作内容、个人贡献与成果展示方法。",
    tags: ["简历", "面试"],
    url: "#",
  },
  {
    school: "示例 · 某中科院所",
    title: "十所院校的夏令营申请记录与分析",
    summary: "申请清单、入营结果与院校考核方式比较。",
    tags: ["选校", "数据"],
    url: "#",
  },
];
---

<section class="section" id="experiences">
  <div class="container">
    <div class="section__head experiences__head">
      <div>
        <span class="eyebrow">经验分享</span>
        <h2 class="section__title">保研申请经验</h2>
      </div>
      <a class="link-arrow experiences__cta" href="#join">
        投稿经验贴
        <svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <div class="posts">
      {
        posts.map((p, i) => (
          <a class={`post reveal reveal--delay-${i + 1}`} href={p.url}>
            <span class="post__school">{p.school}</span>
            <h3 class="post__title">{p.title}</h3>
            <p class="post__summary">{p.summary}</p>
            <div class="post__tags">
              {p.tags.map((t) => (
                <span class="post__tag">{t}</span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .experiences__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    max-width: none;
  }
  .experiences__cta {
    flex: none;
    padding-bottom: 6px;
  }
  .posts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(14px, 1.6vw, 20px);
  }
  .post {
    display: flex;
    flex-direction: column;
    background: var(--bg-grey);
    border-radius: var(--r-lg);
    padding: clamp(22px, 2.6vw, 30px);
    transition: background-color 0.2s ease;
  }
  .post:hover {
    background: #eef2f7;
  }
  .post:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }
  .post__school {
    font-size: 0.85rem;
    color: var(--ink-3);
    font-weight: 600;
  }
  .post__title {
    margin: 12px 0 10px;
    font-size: 1.34rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .post__summary {
    flex: 1;
    color: var(--ink-2);
    font-size: 1.02rem;
    line-height: 1.45;
  }
  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .post__tag {
    font-size: 0.8rem;
    font-weight: 500;
    padding: 4px 11px;
    border-radius: var(--r-pill);
    background: var(--bg);
    color: var(--ink-2);
  }
  .post__tag:nth-child(2) {
    background: var(--purple-soft);
    color: var(--purple);
  }
  .post__tag:nth-child(3) {
    background: #fef1e7;
    color: #e8590c;
  }

  .mobile-br {
    display: none;
  }

  @media (max-width: 860px) {
    .posts {
      grid-template-columns: 1fr;
    }
    .experiences__head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
