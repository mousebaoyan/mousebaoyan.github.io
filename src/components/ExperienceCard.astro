---
interface Props {
  title: string;
  author: string;
  date: Date;
  school: string;
  target: string;
  excerpt: string;
  tags: string[];
  slug: string;
  headingLevel?: "h2" | "h3";
}
const { title, author, date, school, target, excerpt, tags, slug, headingLevel: Heading = "h3" } = Astro.props;
const dateLabel = date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" });
---

<a class="exp-card" href={`/experiences/${slug}`} aria-label={`阅读经验贴：${title}`}>
  <div class="exp-card__content">
    <div class="exp-card__meta">
      <span class="exp-card__author">
        <span class="exp-card__avatar" aria-hidden="true">{Array.from(author)[0]}</span>
        {author}
      </span>
      <span class="exp-card__separator" aria-hidden="true">·</span>
      <time datetime={date.toISOString()}>{dateLabel}</time>
    </div>
    <Heading class="exp-card__title" title={title}>{title}</Heading>
    <p class="exp-card__excerpt">{excerpt}</p>
    <div class="exp-card__tags">
      {tags.slice(0, 3).map((tag) => <span class="exp-card__tag">{tag}</span>)}
    </div>
  </div>

  <div class="exp-card__context">
    <dl class="exp-card__background">
      <div>
        <dt>本科背景</dt>
        <dd>{school}</dd>
      </div>
      <div>
        <dt>录取去向</dt>
        <dd class="exp-card__target">{target}</dd>
      </div>
    </dl>
    <span class="exp-card__read" aria-hidden="true">
      阅读全文
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16m-6-6 6 6-6 6" /></svg>
    </span>
  </div>
</a>

<style>
  .exp-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 40px;
    padding: 20px 28px;
    border: 1px solid var(--line-soft);
    border-radius: 16px;
    background: var(--bg);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .exp-card:hover {
    border-color: #bfd3e8;
    background: #fafcff;
  }
  .exp-card:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }
  .exp-card__content {
    min-width: 0;
  }
  .exp-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: #757a83;
    font-size: 12px;
  }
  .exp-card__author {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #505967;
    font-size: 13px;
  }
  .exp-card__avatar {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #edf3f9;
    color: #416286;
    font-size: 12px;
  }
  .exp-card__separator {
    color: #afb4bc;
  }
  .exp-card__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 10px;
    font-size: 23px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .exp-card__excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 8px;
    color: #6b7079;
    font-size: 15px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .exp-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }
  .exp-card__tag {
    padding: 3px 8px;
    border-radius: 5px;
    background: #f3f5f8;
    color: #626c7a;
    font-size: 11px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .exp-card__context {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-left: 28px;
    border-left: 1px solid var(--line-soft);
    min-width: 0;
  }
  .exp-card__background {
    display: grid;
    gap: 16px;
    width: 100%;
  }
  .exp-card__background dt {
    margin-bottom: 4px;
    color: #777d87;
    font-size: 12px;
  }
  .exp-card__background dd {
    color: #4c5563;
    font-size: 14px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .exp-card__background .exp-card__target {
    color: #343e4d;
    font-weight: 500;
  }
  .exp-card__read {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-top: 16px;
    margin-top: auto;
    color: #1761ae;
    font-size: 13px;
  }
  @media (max-width: 860px) {
    .exp-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding: 20px 24px;
    }
    .exp-card__context {
      border-left: 0;
      border-top: 1px solid var(--line-soft);
      padding: 14px 0 0;
    }
    .exp-card__background {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
    .exp-card__read {
      align-self: flex-end;
      padding-top: 10px;
    }
  }
  @media (max-width: 540px) {
    .exp-card {
      padding: 18px 20px;
      gap: 16px;
    }
    .exp-card__title {
      -webkit-line-clamp: 3;
      font-size: 19px;
      line-height: 1.6;
    }
    .exp-card__excerpt {
      font-size: 14px;
    }
    .exp-card__tags {
      margin-top: 10px;
    }
    .exp-card__background dd {
      font-size: 13px;
    }
  }
</style>
