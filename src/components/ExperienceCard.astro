---
import type { CollectionEntry } from "astro:content";
import { readingStats, splitSchool } from "../lib/experiences";

interface Props {
  entry: CollectionEntry<"experiences">;
}
const { entry } = Astro.props;
const { title, author, date, school, target, major } = entry.data;
const { from, major: subject } = splitSchool(school);
const { minutes } = readingStats(entry.body);
---

<a class="exp lift" href={`/experiences/${entry.id}`}>
  <!-- 一段竖向的路线：空心点是本科院校，实心点是录取去向 -->
  <span class="exp__route">
    <span class="exp__stop exp__stop--from">
      <span class="visually-hidden">本科</span>
      <span class="exp__school">{from}</span>
      {subject && <span class="exp__subject">{subject}</span>}
    </span>
    <span class="exp__stop exp__stop--to">
      <span class="visually-hidden">录取去向</span>
      <span class="exp__target">{target}</span>
      {major && <span class="exp__direction">{major}</span>}
    </span>
  </span>
  <h2 class="exp__title">{title}</h2>
  <span class="exp__foot">
    <span class="exp__avatar" aria-hidden="true">{Array.from(author)[0]}</span>
    <span class="exp__author">{author}</span>
    <time datetime={date.toISOString()}>{date.getMonth() + 1} 月 {date.getDate()} 日</time>
    <span>约 {minutes} 分钟</span>
  </span>
</a>

<style>
  .exp {
    display: flex;
    flex-direction: column;
    gap: 18px;
    height: 100%;
    padding: 24px 26px 22px;
    border: 1px solid var(--line-soft);
    border-radius: 18px;
    background: var(--surface);
  }
  @media (hover: hover) {
    .exp:hover {
      border-color: var(--line);
    }
  }
  .exp:focus-visible {
    outline-offset: 4px;
  }
  .exp__route {
    display: grid;
    gap: 14px;
  }
  .exp__stop {
    position: relative;
    display: grid;
    gap: 3px;
    min-width: 0;
    padding-left: 28px;
  }
  .exp__stop::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 0.42em;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-sizing: border-box;
  }
  .exp__stop--from::before {
    border: 2px solid var(--ink-4);
    background: var(--surface);
  }
  .exp__stop--to::before {
    top: 0.5em;
    background: var(--ink);
  }
  /* 两点之间的虚线 */
  .exp__stop--from::after {
    content: "";
    position: absolute;
    left: 7px;
    top: calc(0.42em + 16px);
    bottom: -14px;
    border-left: 2px dotted var(--ink-4);
  }
  .exp__school {
    color: var(--ink-1);
    font-size: 14px;
    line-height: 1.5;
  }
  .exp__subject {
    color: var(--ink-3);
    font-size: 13px;
  }
  .exp__target {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }
  .exp__direction {
    justify-self: start;
    margin-top: 4px;
    padding: 2px 9px;
    border-radius: 6px;
    background: var(--chip-bg);
    color: var(--chip-ink);
    font-size: 12px;
    line-height: 1.6;
  }
  .exp__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    padding-top: 16px;
    border-top: 1px solid var(--line-soft);
    color: var(--ink-2);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.7;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }
  @media (hover: hover) {
    .exp:hover .exp__title {
      color: var(--ink);
    }
  }
  .exp__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-top: auto;
    color: var(--ink-3);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .exp__avatar {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-right: -4px;
    border-radius: 50%;
    background: var(--avatar-bg);
    color: var(--avatar-ink);
    font-size: 12px;
  }
  .exp__author {
    color: var(--ink-1);
  }
  @media (max-width: 540px) {
    .exp {
      padding: 20px 20px 18px;
    }
    .exp__target {
      font-size: 18px;
    }
  }
</style>
