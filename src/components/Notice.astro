---
import { notice } from "../site.config";
---

{notice && (
  <dialog class="notice" id="site-notice" tabindex="-1" aria-labelledby="notice-title" data-notice-id={notice.id} transition:persist="site-notice">
    <header class="notice__head">
      <p class="notice__meta">
        <span class="notice__status"><span class="notice__dot" aria-hidden="true"></span>{notice.status}</span>
        <span>网站公告 · <time datetime={notice.date}>{notice.date.replaceAll("-", ".")}</time></span>
      </p>
      <button class="notice__close" type="button" aria-label="关闭公告" data-notice-close>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg>
      </button>
    </header>
    <div class="notice__body">
      <h2 id="notice-title">{notice.title}</h2>
      {notice.paragraphs.map((text) => <p>{text}</p>)}
    </div>
    <footer class="notice__foot">
      <span class="notice__sign">—— {notice.signature}</span>
      <div class="notice__actions">
        {notice.action ? (
          <>
            <button class="btn btn--secondary btn--small" type="button" data-notice-close>我知道了</button>
            <a class="btn btn--primary btn--small" href={notice.action.href} data-notice-close>{notice.action.label}</a>
          </>
        ) : (
          <button class="btn btn--primary btn--small" type="button" data-notice-close>我知道了</button>
        )}
      </div>
    </footer>
  </dialog>
)}

<style>
  .notice { position: fixed; inset: 0; margin: auto; padding: 0; width: min(520px, calc(100% - 32px)); max-width: none; max-height: calc(100dvh - 48px); border: 1px solid var(--line-soft); border-radius: 18px; color: var(--ink); background: var(--surface); box-shadow: var(--shadow-pop); overflow: hidden; }
  /* 打开时焦点落在弹窗本身，避免关闭按钮一出现就带着焦点框 */
  .notice:focus { outline: none; }
  .notice[open] { display: flex; flex-direction: column; animation: notice-in 0.42s var(--ease-out); }
  .notice::backdrop { background: var(--backdrop); backdrop-filter: blur(5px); }
  .notice[open]::backdrop { animation: notice-backdrop-in 0.3s ease; }
  @keyframes notice-in { from { opacity: 0; transform: translateY(12px) scale(0.98); } }
  @keyframes notice-backdrop-in { from { opacity: 0; } }
  .notice__head { display: flex; flex: none; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 18px 0 26px; }
  .notice__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; color: var(--ink-3); font-size: 12px; }
  .notice__status { display: inline-flex; align-items: center; gap: 7px; padding: 4px 10px 4px 9px; border-radius: var(--r-pill); background: color-mix(in srgb, var(--tone-pre) 16%, transparent); color: var(--tone-pre-ink); font-weight: 600; }
  :global(:root[data-theme="dark"]) .notice__status { color: var(--tone-pre); }
  .notice__dot { position: relative; width: 7px; height: 7px; border-radius: 50%; background: var(--tone-pre); }
  .notice__close { display: grid; flex: none; place-items: center; width: 36px; height: 36px; padding: 0; border: 1px solid var(--line-soft); border-radius: 9px; color: var(--ink-2); background: var(--surface); cursor: pointer; }
  @media (hover: hover) {
    .notice__close:hover { background: var(--bg-grey); color: var(--ink); }
  }
  .notice__body { padding: 14px 26px 6px; overflow-y: auto; overscroll-behavior: contain; }
  .notice__body h2 { margin-bottom: 14px; font-size: 22px; line-height: 1.35; letter-spacing: -0.01em; }
  .notice__body p { color: var(--ink-1); font-size: 15px; line-height: 1.8; }
  .notice__body p + p { margin-top: 10px; }
  .notice__foot { display: flex; flex: none; align-items: center; justify-content: space-between; gap: 16px; margin-top: 12px; padding: 16px 18px 18px 26px; border-top: 1px solid var(--line-soft); }
  .notice__sign { color: var(--ink-3); font-size: 13px; }
  .notice__actions { display: flex; gap: 8px; }
  .notice :is(a, button):focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
  @media (prefers-reduced-motion: no-preference) {
    .notice__dot::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: inherit; animation: notice-pulse 1.8s ease-out infinite; }
    @keyframes notice-pulse { to { opacity: 0; transform: scale(2.6); } }
  }
  @media (max-width: 600px) {
    .notice__head { padding-left: 20px; }
    .notice__body { padding-inline: 20px; }
    .notice__body h2 { font-size: 20px; }
    .notice__foot { padding-left: 20px; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#site-notice");
  if (dialog) {
    const key = "notice-seen";
    const id = dialog.dataset.noticeId!;
    let opener: HTMLElement | null = null;
    let previousOverflow = "";

    const open = () => {
      if (document.querySelector("dialog[open]")) return;
      opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      previousOverflow = document.documentElement.style.overflow;
      dialog.showModal();
      dialog.focus();
      document.documentElement.style.overflow = "hidden";
    };
    dialog.querySelectorAll("[data-notice-close]").forEach((button) => button.addEventListener("click", () => dialog.close()));
    dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = previousOverflow;
      opener?.focus({ preventScroll: true });
      try { sessionStorage.setItem(key, id); } catch { /* 无法存储时每页都会弹出 */ }
    });
    document.querySelectorAll("[data-notice-open]").forEach((button) => button.addEventListener("click", open));

    // 每次打开网站弹出一次，站内翻页不再重复弹出
    let seen = false;
    try { seen = sessionStorage.getItem(key) === id; } catch { /* 视为未读 */ }
    if (!seen) open();
  }
</script>
