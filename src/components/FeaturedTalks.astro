---
import TalkCard from "./TalkCard.astro";
import { getTalks, isAvailable } from "../lib/talks";

const talks = await getTalks();
const featured = talks.filter(isAvailable).slice(0, 2);
---

{featured.length > 0 && (
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="section-head__title">直播回放</h2>
          <p class="section-head__lead">鼠群往期保研经验分享直播的录屏与课件</p>
        </div>
        <a class="link-arrow" href="/talks">
          全部 {talks.length} 场
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="featured-talks">
        {featured.map((talk) => <TalkCard talk={talk} headingLevel="h3" />)}
      </div>
    </div>
  </section>
)}

<style>
  .featured-talks {
    display: grid;
    gap: clamp(14px, 1.6vw, 20px);
  }
</style>
