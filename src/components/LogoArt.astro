---
// 鼠群标志的画面：朝阳升起，鼠鼠们在岸上。宽度跟随父元素
import logo from "../assets/logo-640.webp";

interface Props { priority?: boolean }
const { priority = false } = Astro.props;
---

<div class="logo-art" aria-hidden="true">
  <span class="logo-art__sun"></span>
  <span class="logo-art__dot logo-art__dot--a"></span>
  <span class="logo-art__dot logo-art__dot--b"></span>
  <span class="logo-art__dot logo-art__dot--c"></span>
  <span class="logo-art__tile">
    <img src={logo.src} width={logo.width} height={logo.height} alt=""
      fetchpriority={priority ? "high" : undefined} loading={priority ? "eager" : "lazy"} decoding="async" />
  </span>
</div>

<style>
  .logo-art {
    --sun: #f4be92;
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 0.96;
  }
  :global(:root[data-theme="dark"]) .logo-art {
    --sun: #b8785a;
  }
  .logo-art__sun {
    position: absolute;
    top: 0;
    right: 0;
    width: 58%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--sun);
  }
  .logo-art__dot {
    position: absolute;
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .logo-art__dot--a {
    top: 4%;
    left: 22%;
    width: 4%;
    background: var(--sun);
  }
  .logo-art__dot--b {
    top: 12%;
    left: 10%;
    width: 2%;
    background: var(--ink-4);
  }
  .logo-art__dot--c {
    top: 2%;
    left: 38%;
    width: 1.6%;
    background: var(--line-strong);
  }
  .logo-art__tile {
    position: absolute;
    left: 4%;
    top: 14%;
    width: 78%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 28%;
    box-shadow: 0 30px 60px -28px rgba(52, 66, 66, 0.45);
    rotate: -4deg;
  }
  .logo-art__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 1.04;
  }
  :global(:root[data-theme="dark"]) .logo-art__tile img {
    filter: brightness(0.88);
  }
  /* 从站外打开时：朝阳升起、标志落定 */
  :global(:root[data-entrance]) .logo-art__sun {
    animation: logo-art-rise 1.4s var(--ease-out) 0.1s both;
  }
  :global(:root[data-entrance]) .logo-art__tile {
    animation: logo-art-settle 1.1s var(--ease-out) both;
  }
  :global(:root[data-entrance]) .logo-art__dot {
    animation: logo-art-fade 1s ease 0.5s both;
  }
  @keyframes logo-art-rise {
    from { opacity: 0; translate: 0 22%; }
  }
  @keyframes logo-art-settle {
    from { opacity: 0; rotate: 0deg; scale: 0.96; }
  }
  @keyframes logo-art-fade {
    from { opacity: 0; }
  }
</style>
